+TEST(LeanWindowFrame, ScaleToFitDoesNotShrinkAcrossRoundTrips) {
+    // 1080p guest starting at 1098x618 (1098x650 with a 32 px title bar,
+    // ModAVD#249): alternating portrait and landscape keeps the exact size.
+    int w = 1098;
+    int h = 618;
+    for (int i = 0; i < 6; ++i) {
+        const lw::Size orig = (i % 2 == 0) ? lw::Size{1080, 1920}
+                                           : lw::Size{1920, 1080};
+        const lw::Size target = {h, w};
+        const double scale = lw::scaleToFit(orig, target);
+        w = static_cast<int>(std::ceil(orig.width * scale));
+        h = static_cast<int>(std::ceil(orig.height * scale));
+        EXPECT_EQ(w, target.width);
+        EXPECT_EQ(h, target.height);
+    }
+    EXPECT_EQ(w, 1098);
+    EXPECT_EQ(h, 618);
+}
+
+TEST(LeanWindowFrame, ScaleToFitNeverOvershootsUnderCeil) {
+    // Cases where target / original can round up by 1 ULP under IEEE-754 and
+    // would overshoot by 1 px under skin_window_resize's ceil().
+    for (const lw::Size target : {lw::Size{481, 271}, lw::Size{496, 279},
+                                  lw::Size{511, 288}, lw::Size{1098, 618}}) {
+        const double scale = lw::scaleToFit({1920, 1080}, target);
+        EXPECT_LE(static_cast<int>(std::ceil(1920 * scale)), target.width);
+        EXPECT_LE(static_cast<int>(std::ceil(1080 * scale)), target.height);
+    }
+    // With -no-hidpi-scaling (dpr > 1), ceil(ceil(original * scale) / dpr)
+    // stays within target too.
+    for (const double dpr : {1.25, 1.5, 1.75, 2.0}) {
+        const double scale = lw::scaleToFit({1920, 1080}, {1098, 618}, dpr);
+        const int w = static_cast<int>(
+                std::ceil(std::ceil(1920 * scale) / dpr));
+        const int h = static_cast<int>(
+                std::ceil(std::ceil(1080 * scale) / dpr));
+        EXPECT_LE(w, 1098);
+        EXPECT_LE(h, 618);
+    }
+    // Floor at 0.2 and guard invalid inputs.
+    EXPECT_DOUBLE_EQ(lw::scaleToFit({1920, 1080}, {100, 100}), 0.2);
+    EXPECT_DOUBLE_EQ(lw::scaleToFit({0, 1080}, {1098, 618}), 0.2);
+}
