 #include <algorithm>
 #include <cmath>
+#include <cstdlib>
 
 namespace android {
 namespace lean_window {
@@ -213,5 +214,104 @@ Rect placeKeepingCenter(const Rect& before, int width, int height,
     return {left, top, left + width, top + height};
 }
 
+double scaleToFit(const Size& original, const Size& target, double dpr) {
+    constexpr double kMinScale = 0.2;
+    if (original.width <= 0 || original.height <= 0 || target.width <= 0 ||
+        target.height <= 0 || dpr <= 0.0) {
+        return kMinScale;
+    }
+    const double maxW = dpr > 1.0 ? std::floor(target.width * dpr)
+                                  : static_cast<double>(target.width);
+    const double maxH = dpr > 1.0 ? std::floor(target.height * dpr)
+                                  : static_cast<double>(target.height);
+    double scale = std::min(maxW / original.width, maxH / original.height);
+    if (scale <= kMinScale) {
+        return kMinScale;
+    }
+    const auto fits = [&](double s) {
+        double w = std::ceil(original.width * s);
+        double h = std::ceil(original.height * s);
+        if (dpr > 1.0) {
+            w = std::ceil(w / dpr);
+            h = std::ceil(h / dpr);
+        }
+        return static_cast<int>(w) <= target.width &&
+               static_cast<int>(h) <= target.height;
+    };
+    for (int i = 0; i < 4 && scale > kMinScale && !fits(scale); ++i) {
+        scale = std::nextafter(scale, 0.0);
+    }
+    return std::max(kMinScale, scale);
+}
+
+void RotationMemory::beginTurn(const Rect& currentFrame,
+                               const Size& currentGuest,
+                               bool wide) {
+    constexpr int kTolerance = 2;
+    const auto close = [](int a, int b) {
+        return std::abs(a - b) <= kTolerance;
+    };
+    const bool sameAsPlaced = hasPlaced && placedWide == wide;
+    const bool sameSize =
+            sameAsPlaced && close(currentFrame.width(), placedFrame.width()) &&
+            close(currentFrame.height(), placedFrame.height());
+    const bool samePos = sameSize && close(currentFrame.left, placedFrame.left) &&
+                         close(currentFrame.top, placedFrame.top);
+    if (hasSaved && savedWide == !wide && sameSize) {
+        restoreSize = true;
+        restoreGuest = savedGuest;
+        restorePosition = samePos;
+        restoreFrame = samePos ? savedFrame : Rect{0, 0, 0, 0};
+    } else {
+        restoreSize = false;
+        restoreGuest = {0, 0};
+        restorePosition = false;
+        restoreFrame = {0, 0, 0, 0};
+    }
+    pendingWide = wide;
+    pendingFrame = currentFrame;
+    pendingGuest = currentGuest;
+}
+
+Size RotationMemory::targetGuest(bool targetWide,
+                                 const Size& guest,
+                                 const Size& around,
+                                 const Rect& work) const {
+    const Size desired = (restoreSize && hasSaved && savedWide == targetWide)
+                                 ? restoreGuest
+                                 : guest;
+    return fitInto(desired, around, work);
+}
+
+Rect RotationMemory::targetFrame(bool targetWide,
+                                 const Rect& before,
+                                 int frameWidth,
+                                 int frameHeight,
+                                 const Rect& work) const {
+    const Rect anchor =
+            (restorePosition && hasSaved && savedWide == targetWide)
+                    ? restoreFrame
+                    : before;
+    return placeKeepingCenter(anchor, frameWidth, frameHeight, work);
+}
+
+void RotationMemory::finishTurn(const Rect& finalFrame, bool wide) {
+    hasPlaced = true;
+    placedWide = wide;
+    placedFrame = finalFrame;
+
+    hasSaved = true;
+    savedWide = pendingWide;
+    savedFrame = pendingFrame;
+    savedGuest = pendingGuest;
+
+    restoreSize = false;
+    restorePosition = false;
+}
+
+void RotationMemory::clear() {
+    *this = RotationMemory();
+}
+
 }  // namespace lean_window
 }  // namespace android
