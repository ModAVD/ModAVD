+TEST(LeanWindowFrame, RotationMemoryRestoresShrunkSizeAndPosition) {
+    // On a 1920x1040 work area, turning 1098x650 landscape at (100, 100) to
+    // portrait shrinks portrait to 567x1008 (+32 = 1040). Turning back must
+    // restore both 1098x618 and (100, 100), and repeated turns stay steady.
+    const lw::Rect work = {0, 0, 1920, 1040};
+    const lw::Size around = {0, 32};
+    const lw::Rect landStart = {100, 100, 1198, 750};
+    const lw::Size landGuest = {1098, 618};
+
+    lw::RotationMemory mem;
+    lw::Rect curFrame = landStart;
+    lw::Size curGuest = landGuest;
+    for (int i = 0; i < 3; ++i) {
+        // Landscape -> Portrait.
+        mem.beginTurn(curFrame, curGuest, true);
+        const lw::Size portGuest = mem.targetGuest(
+                false, {curGuest.height, curGuest.width}, around, work);
+        EXPECT_EQ(portGuest.width, 567);
+        EXPECT_EQ(portGuest.height, 1008);
+        const lw::Rect portFrame = mem.targetFrame(
+                false, curFrame, portGuest.width, portGuest.height + 32, work);
+        EXPECT_EQ(portFrame.top, 0);
+        mem.finishTurn(portFrame, false);
+
+        // Portrait -> Landscape (skin starts at portrait's shrunk scale).
+        mem.beginTurn(portFrame, portGuest, false);
+        const lw::Size backGuest = mem.targetGuest(
+                true, {portGuest.height, portGuest.width}, around, work);
+        EXPECT_EQ(backGuest.width, 1098);
+        EXPECT_EQ(backGuest.height, 618);
+        const lw::Rect backFrame = mem.targetFrame(
+                true, portFrame, backGuest.width, backGuest.height + 32, work);
+        EXPECT_EQ(backFrame.left, 100);
+        EXPECT_EQ(backFrame.top, 100);
+        EXPECT_EQ(backFrame.width(), 1098);
+        EXPECT_EQ(backFrame.height(), 650);
+        mem.finishTurn(backFrame, true);
+        curFrame = backFrame;
+        curGuest = backGuest;
+    }
+}
+
+TEST(LeanWindowFrame, RotationMemoryDropsPositionAfterUserMove) {
+    // Moving the portrait window forgets the old landscape position (so turning
+    // back stays near where the user put it), while keeping the unshrunk size.
+    const lw::Rect work = {0, 0, 1920, 1040};
+    const lw::Size around = {0, 32};
+    const lw::Rect landStart = {100, 100, 1198, 750};
+
+    lw::RotationMemory mem;
+    mem.beginTurn(landStart, {1098, 618}, true);
+    const lw::Size portGuest =
+            mem.targetGuest(false, {618, 1098}, around, work);
+    const lw::Rect portPlaced = mem.targetFrame(
+            false, landStart, portGuest.width, portGuest.height + 32, work);
+    mem.finishTurn(portPlaced, false);
+
+    // User drags portrait right by 700 px without resizing.
+    const lw::Rect portMoved = {portPlaced.left + 700, portPlaced.top,
+                                portPlaced.right + 700, portPlaced.bottom};
+    mem.beginTurn(portMoved, portGuest, false);
+    const lw::Size backGuest = mem.targetGuest(
+            true, {portGuest.height, portGuest.width}, around, work);
+    EXPECT_EQ(backGuest.width, 1098);
+    EXPECT_EQ(backGuest.height, 618);
+    const lw::Rect backFrame =
+            mem.targetFrame(true, portMoved, 1098, 650, work);
+    const lw::Rect centered =
+            lw::placeKeepingCenter(portMoved, 1098, 650, work);
+    EXPECT_EQ(backFrame.left, centered.left);
+    EXPECT_EQ(backFrame.top, centered.top);
+}
+
+TEST(LeanWindowFrame, RotationMemoryForgetsAfterUserResize) {
+    // Resizing the portrait window invalidates both saved size and position.
+    const lw::Rect work = {0, 0, 1920, 1040};
+    const lw::Size around = {0, 32};
+    const lw::Rect landStart = {100, 100, 1198, 750};
+
+    lw::RotationMemory mem;
+    mem.beginTurn(landStart, {1098, 618}, true);
+    const lw::Size portGuest =
+            mem.targetGuest(false, {618, 1098}, around, work);
+    const lw::Rect portPlaced = mem.targetFrame(
+            false, landStart, portGuest.width, portGuest.height + 32, work);
+    mem.finishTurn(portPlaced, false);
+
+    // User shrinks portrait to 360x640 (+32 = 672).
+    const lw::Rect portResized = {portPlaced.left, portPlaced.top,
+                                  portPlaced.left + 360, portPlaced.top + 672};
+    mem.beginTurn(portResized, {360, 640}, false);
+    const lw::Size backGuest =
+            mem.targetGuest(true, {640, 360}, around, work);
+    EXPECT_EQ(backGuest.width, 640);
+    EXPECT_EQ(backGuest.height, 360);
+    const lw::Rect backFrame =
+            mem.targetFrame(true, portResized, 640, 392, work);
+    const lw::Rect centered =
+            lw::placeKeepingCenter(portResized, 640, 392, work);
+    EXPECT_EQ(backFrame.left, centered.left);
+    EXPECT_EQ(backFrame.top, centered.top);
+}
+
+TEST(LeanWindowFrame, RotationMemoryClearResetsState) {
+    const lw::Rect work = {0, 0, 2560, 1400};
+    const lw::Rect landStart = {100, 100, 1198, 750};
+
+    lw::RotationMemory mem;
+    mem.beginTurn(landStart, {1098, 618}, true);
+    const lw::Rect portFrame =
+            mem.targetFrame(false, landStart, 618, 1130, work);
+    mem.finishTurn(portFrame, false);
+
+    mem.clear();
+    mem.beginTurn(portFrame, {618, 1098}, false);
+    const lw::Rect backFrame =
+            mem.targetFrame(true, portFrame, 1098, 650, work);
+    const lw::Rect centered =
+            lw::placeKeepingCenter(portFrame, 1098, 650, work);
+    EXPECT_EQ(backFrame.left, centered.left);
+    EXPECT_EQ(backFrame.top, centered.top);
+}
