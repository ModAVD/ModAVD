+// The frame and guest size remembered across turns of the lean window's
+// rotate button (ModAVD#249): turning back restores what was there before
+// instead of keeping a clamped position or a size shrunk to fit the other
+// orientation.
+struct RotationMemory {
+    // What the last completed turn left the window at; used on the next turn
+    // to tell whether the user moved or resized the window in between.
+    bool hasPlaced = false;
+    bool placedWide = false;
+    Rect placedFrame = {0, 0, 0, 0};
+
+    // The frame and guest size of the other orientation before we turned away
+    // from it.
+    bool hasSaved = false;
+    bool savedWide = false;
+    Rect savedFrame = {0, 0, 0, 0};
+    Size savedGuest = {0, 0};
+
