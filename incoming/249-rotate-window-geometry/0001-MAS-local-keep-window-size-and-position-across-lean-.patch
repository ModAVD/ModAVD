+    lw::RotationMemory mem;
+    mem.beginTurn(landStart, landGuest, true);
+    const lw::Size portGuest =
+            mem.targetGuest(false, {618, 1098}, around, work);
+    EXPECT_EQ(portGuest.width, 618);
+    EXPECT_EQ(portGuest.height, 1098);
+    const lw::Rect portFrame =
+            mem.targetFrame(false, landStart, 618, 1130, work);
+    EXPECT_EQ(portFrame.top, 0);
+    mem.finishTurn(portFrame, false);
+
+    // Turn back without moving or resizing portrait.
+    mem.beginTurn(portFrame, portGuest, false);
+    const lw::Size backGuest =
+            mem.targetGuest(true, {1098, 618}, around, work);
+    EXPECT_EQ(backGuest.width, 1098);
+    EXPECT_EQ(backGuest.height, 618);
+    const lw::Rect backFrame =
+            mem.targetFrame(true, portFrame, 1098, 650, work);
+    EXPECT_EQ(backFrame.left, landStart.left);
+    EXPECT_EQ(backFrame.top, landStart.top);
+    EXPECT_EQ(backFrame.right, landStart.right);
+    EXPECT_EQ(backFrame.bottom, landStart.bottom);
+    mem.finishTurn(backFrame, true);
