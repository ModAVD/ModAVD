diff --git a/tests/modavd/readback-failure.py b/tests/modavd/readback-failure.py
new file mode 100644
index 0000000..bc1d8d9
--- /dev/null
+++ b/tests/modavd/readback-failure.py
@@ -0,0 +1,107 @@
+# Copyright 2026 Ji Mao Cai
+# SPDX-License-Identifier: Apache-2.0
+
+"""Compile actual ColorBuffer wrappers and callback helper with GL/Vulkan doubles.
+
+Run from a Visual Studio Developer PowerShell. Does not invoke a GPU or recorder.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+def function(source, name):
+    match = re.search(r"^(?:static )?bool " + re.escape(name) + r"\([^;]*?\)\s*\{", source, re.M)
+    assert match, name
+    end = source.index("{", match.start()) + 1
+    depth = 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[match.start():end]
+
+root = Path(__file__).resolve().parents[2]
+source = (root / "host/color_buffer.cpp").read_text(encoding="utf-8")
+functions = "\n".join(function(source, name) for name in ("ColorBuffer::Impl::readToBytes", "ColorBuffer::readToBytes"))
+functions += "\n" + function((root / "host/frame_buffer.cpp").read_text(encoding="utf-8"), "readbackColorBufferWithoutWorker")
+code = r'''
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#define GFXSTREAM_FATAL(...) throw std::runtime_error("no implementation")
+enum class GfxstreamFormat { R8G8B8A8_UNORM, B8G8R8A8_UNORM, R8G8B8X8_UNORM, Other };
+struct Backend {
+    bool success = false;
+    bool readToBytes(int, int, int, int, void* out, uint64_t n) {
+        if (!success) return false;
+        for (uint64_t i = 0; i < n; ++i) ((uint8_t*)out)[i] = uint8_t(i % 4 + 1);
+        return true;
+    }
+    bool readPixels(int x, int y, int w, int h, GfxstreamFormat, void* out, uint64_t n) {
+        return readToBytes(x, y, w, h, out, n);
+    }
+};
+struct ColorBuffer {
+    struct Impl {
+        Backend* mColorBufferGl = nullptr;
+        Backend* mColorBufferVk = nullptr;
+        void touch() {}
+        bool readToBytes(int, int, int, int, GfxstreamFormat, void*, uint64_t);
+    };
+    Impl* mImpl;
+    GfxstreamFormat format;
+    uint32_t getWidth() const { return 2; }
+    uint32_t getHeight() const { return 2; }
+    GfxstreamFormat getFormat() const { return format; }
+    bool readToBytes(int, int, int, int, GfxstreamFormat, void*, uint64_t);
+};
+@FUNCTIONS@
+int main() {
+    int checks = 0;
+    for (bool gl : {false, true}) {
+#if !GFXSTREAM_ENABLE_HOST_GLES
+        if (gl) continue;
+#endif
+        for (auto format : {GfxstreamFormat::R8G8B8A8_UNORM, GfxstreamFormat::B8G8R8A8_UNORM,
+                            GfxstreamFormat::R8G8B8X8_UNORM}) for (bool bgra : {false, true}) {
+            Backend backend;
+            ColorBuffer::Impl impl;
+            (gl ? impl.mColorBufferGl : impl.mColorBufferVk) = &backend;
+            ColorBuffer cb{&impl, format};
+            uint8_t image[16], previous[16];
+            memset(image, 0xa5, sizeof(image));
+            // First-frame failure, success, consecutive failures, then recovery.
+            for (bool success : {false, true, false, false, true}) {
+                memcpy(previous, image, sizeof(image)); backend.success = success;
+                bool updated = readbackColorBufferWithoutWorker(&cb, image, 2, 2, bgra);
+                assert(updated == success);
+                if (!success) assert(memcmp(previous, image, sizeof(image)) == 0);
+                else for (int i = 0; i < 16; i += 4) {
+                    bool swap = (format == GfxstreamFormat::B8G8R8A8_UNORM) != bgra;
+                    assert(image[i] == (swap ? 3 : 1));
+                    assert(image[i + 1] == 2 && image[i + 2] == (swap ? 1 : 3));
+                    assert(image[i + 3] == (format == GfxstreamFormat::R8G8B8X8_UNORM ? 255 : 4));
+                }
+                ++checks;
+            }
+            assert(!readbackColorBufferWithoutWorker(&cb, image, 3, 2, bgra));
+            assert(!readbackColorBufferWithoutWorker(nullptr, image, 2, 2, bgra));
+            assert(!readbackColorBufferWithoutWorker(&cb, nullptr, 2, 2, bgra));
+            cb.format = GfxstreamFormat::Other;
+            assert(!readbackColorBufferWithoutWorker(&cb, image, 2, 2, bgra));
+        }
+    }
+    printf("readback: %d success/failure/recovery checks, GLES=%d\n", checks, GFXSTREAM_ENABLE_HOST_GLES);
+}
+'''.replace("@FUNCTIONS@", functions)
+with tempfile.TemporaryDirectory(prefix="modavd-readback-") as tmp:
+    cpp = Path(tmp) / "probe.cpp"
+    cpp.write_text(code)
+    for gles in (0, 1):
+        exe = Path(tmp) / ("probe" + str(gles) + ".exe")
+        subprocess.run(["cl", "/nologo", "/std:c++17", "/EHsc", "/DGFXSTREAM_ENABLE_HOST_GLES=" + str(gles),
+                        str(cpp), "/Fe:" + str(exe), "/Fo:" + str(Path(tmp) / "probe.obj")], cwd=tmp, check=True)
+        subprocess.run([str(exe)], check=True)
