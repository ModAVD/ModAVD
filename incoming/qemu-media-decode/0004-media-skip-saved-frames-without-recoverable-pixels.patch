From f9290c8db6fe876d0d32a6f39c6068c534c0a4ab Mon Sep 17 00:00:00 2001
From: jinghero <44921326+jinghero@users.noreply.github.com>
Date: Thu, 5 Nov 2026 13:08:20 +0800
Subject: [PATCH 4/4] media: skip saved frames without recoverable pixels

---
 .../media/src/android/emulation/MediaSnapshotState.cpp   | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/android/emu/media/src/android/emulation/MediaSnapshotState.cpp b/android/emu/media/src/android/emulation/MediaSnapshotState.cpp
index 00afd9d1..73652a01 100644
--- a/android/emu/media/src/android/emulation/MediaSnapshotState.cpp
+++ b/android/emu/media/src/android/emulation/MediaSnapshotState.cpp
@@ -178,8 +178,13 @@ void MediaSnapshotState::load(base::Stream* stream) {
     SNAPSTATE_DPRINT("load now ");
     for (int i = 0; i < fcount; ++i) {
         SNAPSTATE_DPRINT("load now ");
-        loadFrameInfo(stream, savedDecodedFrame);
-        savedFrames.push_back(std::move(savedDecodedFrame));
+        FrameInfo frame{};
+        loadFrameInfo(stream, frame);
+        // Texture names belong to the old GL context. Only frames with
+        // saved pixels can be delivered after loading the snapshot.
+        if (!frame.data.empty()) {
+            savedFrames.push_back(std::move(frame));
+        }
     }
 }
 
