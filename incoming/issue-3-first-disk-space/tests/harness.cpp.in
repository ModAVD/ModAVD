#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cwchar>
#include <cwctype>
#include <iostream>
#include <limits>
#include <memory>
#include <optional>
#include <string>

#ifdef TEST_POSIX
#undef _WIN32
#else
#ifndef _WIN32
#define _WIN32
#endif
#endif

constexpr uint64_t MiB = 1024 * 1024;
constexpr uint64_t GiB = 1024 * MiB;
using DWORD = uint32_t;
constexpr size_t MAX_PATH = 260;
constexpr DWORD FILE_SUPPORTS_SPARSE_FILES = 0x40;

#ifndef _MSC_VER
static int _wcsicmp(const wchar_t* left, const wchar_t* right) {
    while (*left && std::towlower(*left) == std::towlower(*right)) {
        ++left;
        ++right;
    }
    return int(std::towlower(*left)) - int(std::towlower(*right));
}
#endif

struct Fixture {
    std::wstring fs = L"exFAT";
    DWORD flags = 0;
    bool volumePathOk = true;
    bool volumeInfoOk = true;
    bool freeSpaceOk = true;
    bool directoryOk = true;
    bool imageExists = false;
    bool firstTime = true;
    bool initDirExists = true;
    bool initImageExists = true;
    int volumeQueries = 0;
    int freeQueries = 0;
    int seedQueries = 0;
    uint64_t available = 66 * GiB;
    uint64_t seedSize = 64 * MiB;
    uint64_t initImageSize = MiB;
    std::string panic;
} fixture;

struct Win32UnicodeString {
    explicit Win32UnicodeString(const std::string&) {}
    const wchar_t* c_str() const { return L"test-volume"; }
};

static bool GetVolumePathNameW(const wchar_t*, wchar_t* out, size_t) {
    ++fixture.volumeQueries;
    out[0] = L'V';
    return fixture.volumePathOk;
}

static bool GetVolumeInformationW(const wchar_t*, wchar_t*, DWORD, DWORD*, DWORD*,
                                 DWORD* flags, wchar_t* name, DWORD length) {
    *flags = fixture.flags;
    if (name && length) {
        const auto count = std::min<size_t>(fixture.fs.size(), length - 1);
        std::copy_n(fixture.fs.c_str(), count, name);
        name[count] = 0;
    }
    return fixture.volumeInfoOk;
}

struct Hardware {
    const char* disk_dataPartition_path = "userdata-qemu.img";
    const char* disk_dataPartition_initPath = "init.img";
    int64_t disk_dataPartition_size = 64 * GiB;
} hardware;
struct Settings {
    Hardware* hw() { return &hardware; }
} settings;
struct Agents {
    Settings* settings = &::settings;
} agents;
static Agents* getConsoleAgents() { return &agents; }

struct AvdInfo {};
template <class T> struct ScopedCPtr {
    explicit ScopedCPtr(T* value) : value(value) {}
    ~ScopedCPtr() { std::free(value); }
    T* get() const { return value; }
    T* value;
};
static char* avdInfo_getDataInitDirPath(AvdInfo*) {
    auto* value = static_cast<char*>(std::malloc(9));
    std::copy_n("init-dir", 9, value);
    return value;
}

static bool path_exists(const char* path) {
    if (std::string(path) == "init-dir") return fixture.initDirExists;
    if (std::string(path) == "init.img") return fixture.initImageExists;
    return fixture.imageExists;
}
struct PathUtils {
    static std::optional<std::string> pathToDir(const char*) {
        if (!fixture.directoryOk) return std::nullopt;
        return std::string("test-volume");
    }
};
struct System {
    using FileSize = uint64_t;
    static System* get() { static System instance; return &instance; }
    bool pathFreeSpace(const std::string&, FileSize* value) {
        ++fixture.freeQueries;
        *value = fixture.available;
        return fixture.freeSpaceOk;
    }
    FileSize recursiveSize(const char*) {
        ++fixture.seedQueries;
        return fixture.seedSize;
    }
    bool pathFileSize(const char*, FileSize* value) {
        ++fixture.seedQueries;
        if (!fixture.initImageExists) return false;
        *value = fixture.initImageSize;
        return true;
    }
};
template <class... Args> static void android_panic(const char* format, Args... args) {
    char message[1024];
    std::snprintf(message, sizeof(message), format, args...);
    fixture.panic = message;
}

@HELPERS@

static int check() {
    auto* hw = &hardware;
    AvdInfo instance;
    auto* avd = &instance;
    (void)avd;
    if (fixture.firstTime) {
@CHECK@
    }
    return 0;
}

static int assertions = 0;
static int failures = 0;
static void expect(bool condition, const std::string& name) {
    ++assertions;
    if (!condition) {
        ++failures;
        std::cerr << "FAIL: " << name << '\n';
    }
}
static void reset(const wchar_t* fs, int64_t size, uint64_t available, DWORD flags = 0) {
    fixture = Fixture{};
    fixture.fs = fs;
    fixture.flags = flags;
    fixture.available = available;
    hardware = Hardware{};
    hardware.disk_dataPartition_size = size;
}
static int64_t legacyThreshold(int64_t size) {
    return static_cast<int64_t>(1.2 * size);
}

int main() {
#ifndef TEST_POSIX
    for (const auto* fs : {L"NTFS", L"ReFS"}) {
        reset(fs, 64 * GiB, 10 * GiB, FILE_SUPPORTS_SPARSE_FILES);
        expect(check() == 0, "sparse volume accepts 10 GiB");
        expect(fixture.seedQueries == 0, "sparse policy does not inspect seed data");
        fixture.available--;
        expect(check() == 1, "sparse volume rejects one byte below 10 GiB");
        reset(fs, GiB, legacyThreshold(GiB), FILE_SUPPORTS_SPARSE_FILES);
        expect(check() == 1, "small sparse partition retains fractional legacy threshold");
        fixture.available++;
        expect(check() == 0, "small sparse partition retains legacy acceptance");
    }
    for (const auto* fs : {L"FAT32", L"exFAT", L"fat32", L"EXFAT"}) {
        const uint64_t size = 3 * GiB;
        const uint64_t needed = size + 512 * MiB + 64 * MiB;
        reset(fs, size, needed);
        expect(check() == 0, "FAT volume accepts raw + seed + working space below 1.2x");
        fixture.available--;
        expect(check() == 1, "FAT volume rejects one byte below actual budget");
        fixture.available = size - 1;
        expect(check() == 1, "FAT volume rejects less space than the raw image");
        fixture.available = 0;
        expect(check() == 1, "FAT volume rejects an empty volume");
    }
    for (uint64_t size : {6 * GiB, 16 * GiB, 32 * GiB, 64 * GiB, 1024 * GiB}) {
        const uint64_t reserve = std::max(512 * MiB, size / 64);
        reset(L"exFAT", size, size + reserve + 64 * MiB);
        expect(check() == 0, "exFAT accepts the exact budget across partition sizes");
        fixture.available--;
        expect(check() == 1, "exFAT rejects a one-byte deficit across partition sizes");
    }
    reset(L"exFAT", 64 * GiB, 65 * GiB);
    fixture.initDirExists = false;
    fixture.initImageExists = false;
    expect(check() == 0, "missing seed needs only raw and working space");
    reset(L"exFAT", 64 * GiB, 68 * GiB);
    fixture.initDirExists = false;
    fixture.initImageSize = 3 * GiB;
    expect(check() == 0, "copy fallback includes the init image");
    fixture.available--;
    expect(check() == 1, "copy fallback rejects a one-byte deficit");
    fixture.initDirExists = true;
    expect(check() == 1, "copy fallback is budgeted even when the init directory exists");
    reset(L"exFAT", 64 * GiB, 68 * GiB);
    fixture.seedSize = 3 * GiB;
    expect(check() == 0, "large initial directory is included");
    fixture.available--;
    expect(check() == 1, "large initial directory rejects a one-byte deficit");
    reset(L"exFAT", std::numeric_limits<int64_t>::max(), std::numeric_limits<uint64_t>::max());
    fixture.seedSize = std::numeric_limits<uint64_t>::max();
    expect(check() == 1, "impossible combined budget cannot wrap to an acceptance");
    reset(L"exFAT", std::numeric_limits<int64_t>::max(),
          uint64_t(std::numeric_limits<int64_t>::max()) +
          uint64_t(std::numeric_limits<int64_t>::max()) / 64 + 64 * MiB);
    expect(check() == 0, "large exact integer budget is accepted");
    fixture.available--;
    expect(check() == 1, "large integer budget rejects a one-byte deficit");
    reset(L"FAT32", 4 * GiB, 100 * GiB);
    expect(check() == 1, "FAT32 rejects a raw file above its single-file limit");
    expect(fixture.panic.find("FAT32") != std::string::npos, "FAT32 limit has a specific error");
    expect(fixture.panic.find("NTFS") != std::string::npos && fixture.panic.find("exFAT") != std::string::npos,
           "FAT32 limit suggests a supported volume for the instance");
    reset(L"FAT32", 4 * GiB - 1, 5 * GiB);
    expect(check() == 0, "FAT32 accepts a raw file at the file-size limit with enough space");
    for (int64_t size : {int64_t(0), int64_t(-1)}) {
        reset(L"exFAT", size, 0);
        expect(check() == 0, "nonpositive configured sizes retain existing behavior");
    }
    reset(L"exFAT", 64 * GiB, 64 * GiB);
    expect(check() == 1, "exFAT rejects a missing conversion allowance");
    expect(fixture.panic.find("need 66624.00 MB") != std::string::npos,
           "space error reports the FAT budget rather than 1.2x");
    for (uint64_t size : {32 * GiB - 1, 32 * GiB + 1, 3 * GiB + 1}) {
        const auto needed = size + std::max(512 * MiB, size / 64) + 64 * MiB;
        reset(L"exFAT", size, needed);
        expect(check() == 0, "unaligned exact budget is accepted");
        fixture.available--;
        expect(check() == 1, "unaligned budget rejects a one-byte deficit");
    }
#endif
    for (const auto* fs : {L"OtherFS", L"NTFS", L"ReFS", L"FAT"}) {
        reset(fs, 64 * GiB, 70 * GiB);
        expect(check() == 1, "other non-sparse filesystems retain the 1.2x policy");
        expect(fixture.seedQueries == 0, "other filesystems do not inspect seed data");
        fixture.available = 77 * GiB;
        expect(check() == 0, "other filesystems accept sufficient legacy space");
    }
    for (bool failPath : {false, true}) {
        reset(L"exFAT", 64 * GiB, 70 * GiB);
        fixture.volumePathOk = !failPath;
        fixture.volumeInfoOk = failPath;
        expect(check() == 1, "volume information failure retains the legacy guard");
    }
    reset(L"exFAT", 64 * GiB, 0);
    fixture.freeSpaceOk = false;
    expect(check() == 0, "free-space query failure retains existing behavior");
    fixture.directoryOk = false;
    expect(check() == 0, "missing parent directory retains existing behavior");
    for (bool existing : {false, true}) {
        reset(L"exFAT", 64 * GiB, 0);
        fixture.firstTime = existing;
        fixture.imageExists = existing;
        expect(check() == 0, "existing data or later expansion bypasses first-creation check");
        expect(fixture.freeQueries == 0 && fixture.volumeQueries == 0 && fixture.seedQueries == 0,
               "existing data and expansion do not query first-creation space");
    }
    reset(L"exFAT", 64 * GiB, 0);
    fixture.firstTime = false;
    fixture.imageExists = true;
    expect(check() == 0 && fixture.freeQueries == 0, "expansion with an existing image bypasses the check");
#ifdef TEST_POSIX
    for (const auto* fs : {L"NTFS", L"ReFS", L"FAT32", L"exFAT"}) {
        reset(fs, 64 * GiB, 70 * GiB, FILE_SUPPORTS_SPARSE_FILES);
        expect(check() == 1, "non-Windows branch retains the legacy policy");
    }
#endif
    std::cout << assertions - failures << '/' << assertions << " assertions passed\n";
    return failures ? 1 : 0;
}
