+# Copyright 2026 Ji Mao Cai
+# SPDX-License-Identifier: GPL-2.0-only
+
+"""Compile the actual IME pipe and UI event body with platform/Qt adapters.
+
+Run from a Visual Studio Developer PowerShell. This tests queue and recovery
+control flow, not a running Qt window, Windows IME, or Android input method.
+"""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[2]
+hardware = root / 'android/emu/hardware'
+ui = (root / 'android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-qt-window.cpp').read_text(encoding='utf-8')
+start = ui.index('void EmulatorQtWindow::handleInputMethodEvent(')
+ui_function = ui[start:ui.index('\nQVariant EmulatorQtWindow::hostImeQuery(', start)]
+headers = {
+ 'aemu/base/synchronization/Lock.h': '''#pragma once
+#include <mutex>
+namespace android { namespace base {
+struct Lock { std::mutex mutex; };
+struct AutoLock { std::unique_lock<std::mutex> lock; explicit AutoLock(Lock& l) : lock(l.mutex) {} };
+}}''',
+ 'aemu/base/memory/LazyInstance.h': '''#pragma once
+namespace android { namespace base {
+template<class T> struct LazyInstance { T* operator->() { static T value; return &value; } };
+}}
+#define LAZY_INSTANCE_INIT {}''',
+ 'android/utils/debug.h': '''#pragma once
+#define VERBOSE_INFO(...) ((void)0)
+#define dinfo(...) ((void)0)
+#define dwarning(...) ((void)0)''',
+ 'host-common/android_pipe_common.h': '''#pragma once
+#include <cstddef>
+#include <cstdint>
+enum AndroidPipeFlags { PIPE_FLAGS_NONE = 0 };
+enum PipeCloseReason { PIPE_CLOSE_GRACEFUL = 0 };
+struct AndroidPipeBuffer { uint8_t* data; size_t size; };
+enum { PIPE_POLL_HUP = 1, PIPE_POLL_OUT = 2, PIPE_POLL_IN = 4,
+       PIPE_WAKE_READ = 1, PIPE_WAKE_WRITE = 2, PIPE_ERROR_IO = -1, PIPE_ERROR_AGAIN = -2 };''',
+ 'host-common/AndroidPipe.h': '''#pragma once
+#include <memory>
+#include "host-common/android_pipe_common.h"
+namespace android {
+class AndroidPipe {
+public:
+ class Service { public:
+  explicit Service(const char*) {} virtual ~Service() = default;
+  virtual AndroidPipe* create(void*, const char*, AndroidPipeFlags) = 0;
+  static void add(std::unique_ptr<Service>) {}
+ };
+ AndroidPipe(void*, Service*) {} virtual ~AndroidPipe() = default;
+ virtual void onGuestClose(PipeCloseReason) = 0;
+ virtual unsigned onGuestPoll() const = 0;
+ virtual int onGuestRecv(AndroidPipeBuffer*, int) = 0;
+ virtual int onGuestSend(const AndroidPipeBuffer*, int, void**) = 0;
+ virtual void onGuestWantWakeOn(int) = 0;
+ void abortPendingOperation() {} void closeFromHost() {} void signalWake(int) {}
+};
+}''',
+}
+code = r'''
+#include "android/emulation/ModavdImePipe.h"
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <thread>
+#include <vector>
+using android::emulation::ModavdImePipe;
+using Frames = std::vector<std::vector<uint8_t>>;
+static void u32(std::vector<uint8_t>& b, uint32_t n) {
+    for (int i = 0; i < 4; ++i) b.push_back(uint8_t(n >> (i * 8)));
+}
+static uint32_t get(const uint8_t* p) { return uint32_t(p[0]) | uint32_t(p[1]) << 8 |
+    uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24; }
+static void send(android::AndroidPipe* pipe, std::vector<uint8_t> payload) {
+    std::vector<uint8_t> bytes; u32(bytes, uint32_t(payload.size()));
+    bytes.insert(bytes.end(), payload.begin(), payload.end());
+    AndroidPipeBuffer b{bytes.data(), bytes.size()}; assert(pipe->onGuestSend(&b, 1, nullptr) == bytes.size());
+}
+static Frames drain(android::AndroidPipe* pipe) {
+    std::vector<uint8_t> bytes; uint8_t buffer[8192]; AndroidPipeBuffer b{buffer, sizeof(buffer)};
+    for (;;) {
+        int n = pipe->onGuestRecv(&b, 1);
+        if (n == PIPE_ERROR_AGAIN || n == PIPE_ERROR_IO) break;
+        assert(n > 0); bytes.insert(bytes.end(), buffer, buffer + n);
+    }
+    Frames frames;
+    for (size_t pos = 0; pos < bytes.size();) {
+        assert(pos + 4 <= bytes.size()); uint32_t n = get(bytes.data() + pos); pos += 4;
+        assert(n > 0 && n <= 65536 && pos + n <= bytes.size());
+        frames.emplace_back(bytes.begin() + pos, bytes.begin() + pos + n); pos += n;
+    }
+    return frames;
+}
