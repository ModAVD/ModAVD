From 9fb9d94b4e1efab3bd97fb3db3c6c31b9c687f47 Mon Sep 17 00:00:00 2001
From: Ji Mao Cai <44921326+jinghero@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:58:22 +0800
Subject: [PATCH] block: avoid copies and per-page calls for contiguous Windows
 I/O

Collapse a complete adjacent iovec span into one request using its original
buffer. Keep the existing bounce and per-element paths for fragmented vectors.
Reject empty, mismatched, overflowing, and wider-than-DWORD spans before
aggregation. Preserve synchronous completion, error propagation, EOF handling,
and flush behavior.

Refs ModAVD/ModAVD#35
---
 block/file-win32.c | 46 ++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 40 insertions(+), 6 deletions(-)

diff --git a/block/file-win32.c b/block/file-win32.c
index 6b736583d5..25983e7a2d 100644
--- a/block/file-win32.c
+++ b/block/file-win32.c
@@ -80,6 +80,30 @@ typedef struct BDRVRawState {
  */
 #define RAW_WIN32_BOUNCE_MAX (64 * 1024)
 
+/* Adjacent guest buffers need neither a bounce copy nor one call per page. */
+static bool raw_win32_iov_is_contiguous(RawWin32AIOData *aiocb)
+{
+    size_t remaining = aiocb->aio_nbytes;
+    uintptr_t next;
+    int i;
+
+    if (aiocb->aio_niov < 2 || !remaining || remaining > MAXDWORD) {
+        return false;
+    }
+    next = (uintptr_t)aiocb->aio_iov[0].iov_base;
+    for (i = 0; i < aiocb->aio_niov; i++) {
+        size_t len = aiocb->aio_iov[i].iov_len;
+
+        if (!len || len > remaining || len > UINTPTR_MAX - next ||
+            (uintptr_t)aiocb->aio_iov[i].iov_base != next) {
+            return false;
+        }
+        next += len;
+        remaining -= len;
+    }
+    return remaining == 0;
+}
+
 static ssize_t handle_aiocb_rw_bounce(RawWin32AIOData *aiocb, void *buf)
 {
     OVERLAPPED ov;
@@ -118,13 +142,23 @@ static ssize_t handle_aiocb_rw_bounce(RawWin32AIOData *aiocb, void *buf)
  */
 static ssize_t handle_aiocb_rw(RawWin32AIOData *aiocb)
 {
+    struct iovec linear_iov;
+    struct iovec *iov = aiocb->aio_iov;
+    int niov = aiocb->aio_niov;
     size_t offset = 0;
     int i;
 
+    if (raw_win32_iov_is_contiguous(aiocb)) {
+        linear_iov.iov_base = iov[0].iov_base;
+        linear_iov.iov_len = aiocb->aio_nbytes;
+        iov = &linear_iov;
+        niov = 1;
+    }
+
     /* The block layer aligned the original iovecs for direct I/O. A heap
-     * bounce buffer has no such guarantee, so keep those iovecs intact. */
+     * bounce buffer has no such guarantee, so use their original buffers. */
     if (!(aiocb->bs->open_flags & BDRV_O_NOCACHE) &&
-        aiocb->aio_niov > 1 && aiocb->aio_nbytes <= RAW_WIN32_BOUNCE_MAX) {
+        niov > 1 && aiocb->aio_nbytes <= RAW_WIN32_BOUNCE_MAX) {
         void *buf = g_try_malloc(aiocb->aio_nbytes);
         if (buf) {
             ssize_t count = handle_aiocb_rw_bounce(aiocb, buf);
@@ -133,19 +167,19 @@ static ssize_t handle_aiocb_rw(RawWin32AIOData *aiocb)
         }
     }
 
-    for (i = 0; i < aiocb->aio_niov; i++) {
+    for (i = 0; i < niov; i++) {
         OVERLAPPED ov;
         DWORD ret, ret_count, len;
 
         memset(&ov, 0, sizeof(ov));
         ov.Offset = (aiocb->aio_offset + offset);
         ov.OffsetHigh = (aiocb->aio_offset + offset) >> 32;
-        len = aiocb->aio_iov[i].iov_len;
+        len = iov[i].iov_len;
         if (aiocb->aio_type & QEMU_AIO_WRITE) {
-            ret = WriteFile(aiocb->hfile, aiocb->aio_iov[i].iov_base,
+            ret = WriteFile(aiocb->hfile, iov[i].iov_base,
                             len, &ret_count, &ov);
         } else {
-            ret = ReadFile(aiocb->hfile, aiocb->aio_iov[i].iov_base,
+            ret = ReadFile(aiocb->hfile, iov[i].iov_base,
                            len, &ret_count, &ov);
         }
         if (!ret) {
