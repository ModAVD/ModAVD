diff --git a/android-qemu2-glue/windows-temp-images.cpp b/android-qemu2-glue/windows-temp-images.cpp
new file mode 100644
index 00000000..ae5fb3cb
--- /dev/null
+++ b/android-qemu2-glue/windows-temp-images.cpp
@@ -0,0 +1,291 @@
+// Copyright 2026 Ji Mao Cai
+// SPDX-License-Identifier: GPL-2.0-only
+#include "windows-temp-images.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <winioctl.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <map>
+#include <memory>
+#include <mutex>
+
+namespace android::tempimages {
+namespace {
+namespace fs = std::filesystem;
+struct Close {
+    void operator()(void* h) const { CloseHandle(h); }
+};
+using Handle = std::unique_ptr<void, Close>;
+
+Handle open(const fs::path& p,
+            DWORD access,
+            DWORD share,
+            DWORD how,
+            DWORD flags = FILE_FLAG_OPEN_REPARSE_POINT) {
+    HANDLE h =
+            CreateFileW(p.c_str(), access, share, nullptr, how, flags, nullptr);
+    return Handle(h == INVALID_HANDLE_VALUE ? nullptr : h);
+}
+
+using FileRef = std::array<DWORD, 3>;
+
+bool fileRef(HANDLE file, FileRef* ref) {
+    BY_HANDLE_FILE_INFORMATION info{};
+    if (!GetFileInformationByHandle(file, &info) ||
+        !(info.nFileIndexHigh || info.nFileIndexLow))
+        return false;
+    *ref = {info.dwVolumeSerialNumber, info.nFileIndexHigh, info.nFileIndexLow};
+    return true;
+}
+
+// NTFS can tunnel an object ID to a new file created under a recently vacated
+// name. The file reference distinguishes the replacement from the allocated
+// file.
+struct Identity {
+    FileRef file;
+    std::array<BYTE, 16> object;
+};
+bool same(const Identity& a, const Identity& b) {
+    return a.file == b.file && a.object == b.object;
+}
+bool objectId(HANDLE h, DWORD operation, Identity* id) {
+    FILE_OBJECTID_BUFFER info{};
+    DWORD bytes;
+    if (!fileRef(h, &id->file) ||
+        !DeviceIoControl(h, operation, nullptr, 0, &info, sizeof(info), &bytes,
+                         nullptr) ||
+        bytes != sizeof(info))
+        return false;
+    memcpy(id->object.data(), info.ObjectId, id->object.size());
+    return true;
+}
+
+bool singleRegularFile(HANDLE h) {
+    BY_HANDLE_FILE_INFORMATION info;
+    return GetFileInformationByHandle(h, &info) && info.nNumberOfLinks == 1 &&
+           !(info.dwFileAttributes &
+             (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY));
+}
+
+bool erase(HANDLE file) {
+    FILE_DISPOSITION_INFO disposition{TRUE};
+    return SetFileInformationByHandle(file, FileDispositionInfo, &disposition,
+                                      sizeof(disposition));
+}
+
+struct Receipt {
+    char magic[8];
+    FileRef avd;
+    Identity receipt;
+    Identity image;
+};
+
+struct Image {
+    Handle pin;
+    Handle lease;
+    bool overlay;
+};
+
+struct Session {
+    fs::path temp;
+    FileRef avd{};
+    std::wstring avdPath;
+    std::mutex mutex;
+    std::map<std::string, Image> images;
+};
+Session& session() {
+    static Session state;
+    return state;
+}
+
+fs::path leasePath(const fs::path& image) {
+    return fs::path(image).concat(L".lease");
+}
+
+constexpr DWORD kAllShares =
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE;
+constexpr char kMagic[8] = {'M', 'A', 'S', 'T', 'M', 'P', '0', '1'};
+
+// A volume-qualified path also distinguishes a mounted clone with the same
+// filesystem serial and directory index. Resolve the directory actually opened.
+std::wstring directoryPath(HANDLE dir) {
+    DWORD length = GetFinalPathNameByHandleW(dir, nullptr, 0, VOLUME_NAME_GUID);
+    if (!length)
+        return {};
+    std::wstring path(length, L'\0');
+    DWORD copied = GetFinalPathNameByHandleW(dir, path.data(), length,
+                                             VOLUME_NAME_GUID);
+    if (!copied || copied >= length)
+        return {};
+    path.resize(copied);
+    return path;
+}
+
+bool matchesOwnerPath(HANDLE lease) {
+    const auto& expected = session().avdPath;
+    std::wstring recorded(expected.size(), L'\0');
+    DWORD count = static_cast<DWORD>(recorded.size() * sizeof(wchar_t));
+    DWORD bytes;
+    LARGE_INTEGER size;
+    return GetFileSizeEx(lease, &size) &&
+           size.QuadPart == static_cast<LONGLONG>(sizeof(Receipt) + count) &&
+           ReadFile(lease, recorded.data(), count, &bytes, nullptr) &&
+           bytes == count && recorded == expected;
+}
+
+void recover(const fs::path& path) {
+    // The producer holds this receipt exclusively even when no drive handle is
+    // open.
+    auto lease = open(leasePath(path), GENERIC_READ | DELETE, 0, OPEN_EXISTING);
+    Receipt r{};
+    Identity id;
+    DWORD bytes;
+    if (!lease || !singleRegularFile(lease.get()) ||
+        !ReadFile(lease.get(), &r, sizeof(r), &bytes, nullptr) ||
+        bytes != sizeof(r) || memcmp(r.magic, kMagic, sizeof(kMagic)) ||
+        r.avd != session().avd || !matchesOwnerPath(lease.get()) ||
+        !objectId(lease.get(), FSCTL_GET_OBJECT_ID, &id) ||
+        !same(id, r.receipt))
+        return;
+
+    auto file = open(path, FILE_READ_ATTRIBUTES | DELETE, 0, OPEN_EXISTING);
+    if (!file) {
+        if (GetLastError() == ERROR_FILE_NOT_FOUND)
+            erase(lease.get());
+        return;
+    }
+    if (singleRegularFile(file.get()) &&
+        objectId(file.get(), FSCTL_GET_OBJECT_ID, &id) && same(id, r.image) &&
+        erase(file.get()))
+        erase(lease.get());
+}
+
+bool reserve(const fs::path& path, bool overlay) {
+    // CREATE_NEW is the ownership boundary, including for a cache sidecar.
+    auto pin = open(path, FILE_READ_ATTRIBUTES,
+                    FILE_SHARE_READ | FILE_SHARE_WRITE, CREATE_NEW);
+    if (!pin)
+        return false;
+    Handle lease;
+    Receipt r{};
+    memcpy(r.magic, kMagic, sizeof(kMagic));
+    r.avd = session().avd;
+    const auto& avdPath = session().avdPath;
+    DWORD pathBytes = static_cast<DWORD>(avdPath.size() * sizeof(wchar_t));
+    if (!avdPath.empty() &&
+        objectId(pin.get(), FSCTL_CREATE_OR_GET_OBJECT_ID, &r.image)) {
+        lease = open(leasePath(path), GENERIC_WRITE | DELETE, 0, CREATE_NEW);
+        DWORD bytes;
+        if (lease && !(objectId(lease.get(), FSCTL_CREATE_OR_GET_OBJECT_ID,
+                                &r.receipt) &&
+                       WriteFile(lease.get(), &r, sizeof(r), &bytes, nullptr) &&
+                       bytes == sizeof(r) &&
+                       WriteFile(lease.get(), avdPath.data(), pathBytes, &bytes,
+                                 nullptr) &&
+                       bytes == pathBytes && FlushFileBuffers(lease.get()))) {
+            erase(lease.get());
+            lease.reset();
+        }
+    }
+    session().images.emplace(path.u8string(),
+                             Image{std::move(pin), std::move(lease), overlay});
+    return true;
+}
+
+bool releaseLocked(const char* path) {
+    if (!path)
+        return false;
+    auto& images = session().images;
+    auto i = images.find(path);
+    if (i == images.end())
+        return false;
+    // Keep the original object alive while upgrading to an exclusive delete
+    // handle. The temporary pin prevents file-ID reuse if another process
+    // replaces the name.
+    HANDLE original = ReOpenFile(i->second.pin.get(), FILE_READ_ATTRIBUTES,
+                                 kAllShares, 0);
+    if (original != INVALID_HANDLE_VALUE) {
+        Handle pin(original);
+        i->second.pin.reset();
+        auto file = open(fs::u8path(i->first), FILE_READ_ATTRIBUTES | DELETE, 0,
+                         OPEN_EXISTING);
+        FileRef allocated, current;
+        if (file && singleRegularFile(file.get()) &&
+            fileRef(original, &allocated) && fileRef(file.get(), &current) &&
+            allocated == current && erase(file.get())) {
+            if (i->second.lease)
+                erase(i->second.lease.get());
+        }
+    }
+    images.erase(i);
+    return true;
+}
+void releaseAll() {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    while (!session().images.empty())
+        releaseLocked(session().images.begin()->first.c_str());
+}
+}  // namespace
+
+void start(const std::string& avd, const std::string& temp) {
+    auto& s = session();
+    s.temp = fs::u8path(temp);
+    auto dir = open(fs::u8path(avd), FILE_READ_ATTRIBUTES, kAllShares,
+                    OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS);
+    if (dir && fileRef(dir.get(), &s.avd))
+        s.avdPath = directoryPath(dir.get());
+    std::atexit(releaseAll);
+    if (s.avdPath.empty())
+        return;
+    WIN32_FIND_DATAW entry;
+    HANDLE it =
+            FindFirstFileW((s.temp / L"modavd-*.tmp*.lease").c_str(), &entry);
+    if (it == INVALID_HANDLE_VALUE)
+        return;
+    do {
+        if (entry.dwFileAttributes &
+            (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY))
+            continue;
+        auto path = s.temp / entry.cFileName;
+        if (path.extension() == L".lease")
+            recover(path.replace_extension());
+    } while (FindNextFileW(it, &entry));
+    FindClose(it);
+}
+
+std::string create(const std::string& uuid, Kind kind) {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    const char* extension = kind == Kind::DriveOverlay ? ".tmp.qcow2" : ".tmp";
+    const auto path = session().temp / ("modavd-" + uuid + extension);
+    if (!reserve(path, false))
+        return {};
+    auto name = path.u8string();
+    if (kind == Kind::CachePair &&
+        !reserve(fs::path(path).concat(L".qcow2"), true)) {
+        releaseLocked(name.c_str());
+        return {};
+    }
+    return name;
+}
+
+bool takeReservedOverlay(const char* path) {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    auto& images = session().images;
+    auto i = images.find(path);
+    if (i == images.end() || !i->second.overlay)
+        return false;
+    i->second.overlay = false;
+    return true;
+}
+
+bool release(const char* path) {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    return releaseLocked(path);
+}
+}  // namespace android::tempimages
+#endif
