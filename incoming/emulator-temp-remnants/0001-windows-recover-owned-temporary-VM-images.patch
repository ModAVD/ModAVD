diff --git a/android-qemu2-glue/windows-temp-images.cpp b/android-qemu2-glue/windows-temp-images.cpp
new file mode 100644
index 00000000..7cc6a587
--- /dev/null
+++ b/android-qemu2-glue/windows-temp-images.cpp
@@ -0,0 +1,476 @@
+// Copyright 2026 Ji Mao Cai
+// SPDX-License-Identifier: GPL-2.0-only
+#include "windows-temp-images.h"
+
+#ifdef _WIN32
+#include <windows.h>
+
+#include <dpapi.h>
+#include <sddl.h>
+#include <winioctl.h>
+
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace android::tempimages {
+namespace {
+namespace fs = std::filesystem;
+struct Close {
+    void operator()(void* h) const { CloseHandle(h); }
+};
+using Handle = std::unique_ptr<void, Close>;
+
+Handle open(const fs::path& p,
+            DWORD access,
+            DWORD share,
+            DWORD how,
+            DWORD flags = FILE_FLAG_OPEN_REPARSE_POINT,
+            SECURITY_ATTRIBUTES* security = nullptr) {
+    HANDLE h = CreateFileW(p.c_str(), access, share, security, how, flags,
+                           nullptr);
+    return Handle(h == INVALID_HANDLE_VALUE ? nullptr : h);
+}
+
+using FileRef = std::array<DWORD, 3>;
+
+bool fileRef(HANDLE file, FileRef* ref) {
+    BY_HANDLE_FILE_INFORMATION info{};
+    if (!GetFileInformationByHandle(file, &info) ||
+        !(info.nFileIndexHigh || info.nFileIndexLow))
+        return false;
+    *ref = {info.dwVolumeSerialNumber, info.nFileIndexHigh, info.nFileIndexLow};
+    return true;
+}
+
+// NTFS can tunnel an object ID to a new file created under a recently vacated
+// name. The file reference distinguishes the replacement from the allocated
+// file.
+struct Identity {
+    FileRef file;
+    std::array<BYTE, 16> object;
+};
+bool same(const Identity& a, const Identity& b) {
+    return a.file == b.file && a.object == b.object;
+}
+bool objectId(HANDLE h, DWORD operation, Identity* id) {
+    FILE_OBJECTID_BUFFER info{};
+    DWORD bytes;
+    if (!fileRef(h, &id->file) ||
+        !DeviceIoControl(h, operation, nullptr, 0, &info, sizeof(info), &bytes,
+                         nullptr) ||
+        bytes != sizeof(info))
+        return false;
+    memcpy(id->object.data(), info.ObjectId, id->object.size());
+    return true;
+}
+
+bool singleRegularFile(HANDLE h) {
+    BY_HANDLE_FILE_INFORMATION info;
+    return GetFileInformationByHandle(h, &info) && info.nNumberOfLinks == 1 &&
+           !(info.dwFileAttributes &
+             (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY));
+}
+
+bool erase(HANDLE file) {
+    FILE_DISPOSITION_INFO disposition{TRUE};
+    return SetFileInformationByHandle(file, FileDispositionInfo, &disposition,
+                                      sizeof(disposition));
+}
+
+struct Receipt {
+    FileRef avd;
+    FileRef temp;
+    Identity receipt;
+    Identity image;
+};
+
+struct Image {
+    Handle pin;
+    Handle lease;
+    bool overlay;
+};
+
+struct Directory {
+    Handle pin;
+    fs::path path;
+    fs::path dosPath;
+    FileRef id{};
+    bool identified = false;
+    DWORD volume = VOLUME_NAME_GUID;
+};
+
+struct FreeLocal {
+    void operator()(void* p) const { LocalFree(p); }
+};
+using LocalMemory = std::unique_ptr<void, FreeLocal>;
+
+// A shared TEMP may grant other accounts write access. Set the DACL atomically
+// on creation: even an empty placeholder must not be writable as a reparse
+// point.
+LocalMemory privateDescriptor() {
+    HANDLE rawToken;
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &rawToken))
+        return {};
+    Handle token(rawToken);
+    DWORD bytes = 0;
+    GetTokenInformation(token.get(), TokenUser, nullptr, 0, &bytes);
+    if (!bytes)
+        return {};
+    std::vector<BYTE> buffer(bytes);
+    if (!GetTokenInformation(token.get(), TokenUser, buffer.data(), bytes,
+                             &bytes))
+        return {};
+    LPWSTR sidText = nullptr;
+    if (!ConvertSidToStringSidW(
+                reinterpret_cast<TOKEN_USER*>(buffer.data())->User.Sid,
+                &sidText))
+        return {};
+    LocalMemory sid(sidText);
+    std::wstring sddl = L"O:" + std::wstring(sidText) + L"D:P(A;;FA;;;" +
+                        sidText + L")(A;;FA;;;SY)";
+    PSECURITY_DESCRIPTOR result = nullptr;
+    if (!ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                sddl.c_str(), SDDL_REVISION_1, &result, nullptr))
+        return {};
+    return LocalMemory(result);
+}
+
+struct Session {
+    bool initialized = false;
+    std::string avdInput;
+    std::string tempInput;
+    LocalMemory descriptor;
+    Directory avd;
+    Directory temp;
+    std::mutex mutex;
+    std::map<std::string, Image> images;
+};
+Session& session() {
+    static Session state;
+    return state;
+}
+
+Handle createPrivate(const fs::path& path, DWORD access, DWORD share) {
+    if (!session().descriptor) {
+        SetLastError(ERROR_INVALID_SECURITY_DESCR);
+        return {};
+    }
+    SECURITY_ATTRIBUTES security{sizeof(security), session().descriptor.get(),
+                                 FALSE};
+    return open(path, access, share, CREATE_NEW, FILE_FLAG_OPEN_REPARSE_POINT,
+                &security);
+}
+
+fs::path leasePath(const fs::path& image) {
+    return (session().avd.path / image.filename()).concat(L".lease");
+}
+
+constexpr DWORD kAllShares =
+        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE;
+
+fs::path finalPath(HANDLE handle, DWORD volume) {
+    DWORD length = GetFinalPathNameByHandleW(handle, nullptr, 0, volume);
+    if (!length)
+        return {};
+    std::wstring path(length, L'\0');
+    DWORD copied =
+            GetFinalPathNameByHandleW(handle, path.data(), length, volume);
+    if (!copied || copied >= length)
+        return {};
+    path.resize(copied);
+    return fs::path(std::move(path));
+}
+
+Directory pinDirectory(const std::string& path) {
+    Directory dir;
+    // Resolve junctions once. Subsequent path-based QEMU opens must go back to
+    // this directory even if the caller's TEMP or AVD alias is retargeted.
+    // Child-file renames (including first userdata conversion) need shared
+    // write access to the directory. Individual image pins prevent replacement.
+    dir.pin = open(fs::u8path(path), FILE_LIST_DIRECTORY | FILE_READ_ATTRIBUTES,
+                   FILE_SHARE_READ | FILE_SHARE_WRITE, OPEN_EXISTING,
+                   FILE_FLAG_BACKUP_SEMANTICS);
+    if (dir.pin) {
+        auto dos = finalPath(dir.pin.get(), VOLUME_NAME_DOS).native();
+        if (dos.rfind(LR"(\\?\UNC\)", 0) == 0) {
+            dir.dosPath = LR"(\\)" + dos.substr(8);
+        } else if (dos.size() >= 7 && dos.rfind(LR"(\\?\)", 0) == 0 &&
+                   dos[5] == L':') {
+            dir.dosPath = dos.substr(4);
+        }
+        dir.path = finalPath(dir.pin.get(), VOLUME_NAME_GUID);
+        dir.identified = !dir.path.empty() && fileRef(dir.pin.get(), &dir.id);
+        if (dir.path.empty()) {
+            dir.volume = VOLUME_NAME_DOS;
+            dir.path = finalPath(dir.pin.get(), dir.volume);
+        }
+    }
+    return dir;
+}
+
+// Current-user DPAPI authenticates the contents and this context together.
+// A record read under another leaf, AVD, or TEMP directory cannot authorize a
+// delete.
+std::wstring context(const fs::path& image) {
+    std::wstring key = L"ModAVD temporary images v2";
+    for (const auto& part :
+         {session().avd.path, session().temp.path, image.filename()}) {
+        key.push_back(L'\0');
+        key.append(part.native());
+    }
+    return key;
+}
+
+struct Blob : DATA_BLOB {
+    Blob() : DATA_BLOB{} {}
+    Blob(const Blob&) = delete;
+    Blob& operator=(const Blob&) = delete;
+    ~Blob() { LocalFree(pbData); }
+};
+
+bool writeReceipt(HANDLE lease, const fs::path& image, Receipt& receipt) {
+    auto key = context(image);
+    DATA_BLOB entropy{static_cast<DWORD>(key.size() * sizeof(wchar_t)),
+                      reinterpret_cast<BYTE*>(key.data())};
+    DATA_BLOB plain{sizeof(receipt), reinterpret_cast<BYTE*>(&receipt)};
+    Blob sealed;
+    DWORD bytes;
+    return CryptProtectData(&plain, nullptr, &entropy, nullptr, nullptr,
+                            CRYPTPROTECT_UI_FORBIDDEN, &sealed) &&
+           WriteFile(lease, sealed.pbData, sealed.cbData, &bytes, nullptr) &&
+           bytes == sealed.cbData && FlushFileBuffers(lease);
+}
+
+bool readReceipt(HANDLE lease, const fs::path& image, Receipt* receipt) {
+    std::array<BYTE, 4096> buffer;
+    LARGE_INTEGER size;
+    DWORD bytes;
+    if (!GetFileSizeEx(lease, &size) || size.QuadPart <= 0 ||
+        size.QuadPart > static_cast<LONGLONG>(buffer.size()) ||
+        !ReadFile(lease, buffer.data(), static_cast<DWORD>(size.QuadPart),
+                  &bytes, nullptr) ||
+        bytes != size.QuadPart)
+        return false;
+    auto key = context(image);
+    DATA_BLOB entropy{static_cast<DWORD>(key.size() * sizeof(wchar_t)),
+                      reinterpret_cast<BYTE*>(key.data())};
+    DATA_BLOB sealed{bytes, buffer.data()};
+    Blob plain;
+    if (!CryptUnprotectData(&sealed, nullptr, &entropy, nullptr, nullptr,
+                            CRYPTPROTECT_UI_FORBIDDEN, &plain) ||
+        plain.cbData != sizeof(*receipt))
+        return false;
+    memcpy(receipt, plain.pbData, sizeof(*receipt));
+    return true;
+}
+
+void recover(const fs::path& path) {
+    // The producer holds this receipt exclusively even when no drive handle is
+    // open.
+    auto lease = open(leasePath(path), GENERIC_READ | DELETE, 0, OPEN_EXISTING);
+    Receipt r{};
+    Identity id;
+    if (!lease ||
+        finalPath(lease.get(), session().avd.volume) != leasePath(path) ||
+        !singleRegularFile(lease.get()) ||
+        !readReceipt(lease.get(), path, &r) || r.avd != session().avd.id ||
+        r.temp != session().temp.id ||
+        !objectId(lease.get(), FSCTL_GET_OBJECT_ID, &id) ||
+        !same(id, r.receipt))
+        return;
+
+    auto file = open(path, FILE_READ_ATTRIBUTES | DELETE, 0, OPEN_EXISTING);
+    if (!file) {
+        if (GetLastError() == ERROR_FILE_NOT_FOUND)
+            erase(lease.get());
+        return;
+    }
+    if (singleRegularFile(file.get()) &&
+        finalPath(file.get(), session().temp.volume) == path &&
+        objectId(file.get(), FSCTL_GET_OBJECT_ID, &id) && same(id, r.image) &&
+        erase(file.get()))
+        erase(lease.get());
+}
+
+enum class Reservation { Ready, Exists, Failed };
+
+Reservation reserve(const fs::path& path, bool overlay) {
+    // CREATE_NEW is the ownership boundary, including for a cache sidecar.
+    // Metadata-only handles do not participate in Windows share checks.
+    auto pin = createPrivate(path, FILE_READ_DATA | FILE_READ_ATTRIBUTES,
+                             FILE_SHARE_READ | FILE_SHARE_WRITE);
+    if (!pin)
+        return GetLastError() == ERROR_FILE_EXISTS ? Reservation::Exists
+                                                   : Reservation::Failed;
+    if (finalPath(pin.get(), session().temp.volume) !=
+        session().temp.path / path.filename())
+        return Reservation::Failed;
+    Handle lease;
+    Receipt r{};
+    r.avd = session().avd.id;
+    r.temp = session().temp.id;
+    if (session().avd.identified && session().temp.identified &&
+        objectId(pin.get(), FSCTL_CREATE_OR_GET_OBJECT_ID, &r.image)) {
+        lease = createPrivate(leasePath(path), GENERIC_WRITE | DELETE, 0);
+        if (lease &&
+            !(finalPath(lease.get(), session().avd.volume) == leasePath(path) &&
+              objectId(lease.get(), FSCTL_CREATE_OR_GET_OBJECT_ID,
+                       &r.receipt) &&
+              writeReceipt(lease.get(), path, r))) {
+            erase(lease.get());
+            lease.reset();
+        }
+    }
+    session().images.emplace(path.u8string(),
+                             Image{std::move(pin), std::move(lease), overlay});
+    return Reservation::Ready;
+}
+
+bool releaseLocked(const char* path) {
+    if (!path)
+        return false;
+    auto& images = session().images;
+    auto i = images.find(path);
+    if (i == images.end())
+        return false;
+    // Downgrade the no-delete-share pin, then reopen that same kernel object
+    // for deletion. Leave moved files and multiply linked images alone.
+    HANDLE original = ReOpenFile(i->second.pin.get(), FILE_READ_ATTRIBUTES,
+                                 kAllShares, 0);
+    if (original != INVALID_HANDLE_VALUE) {
+        Handle pin(original);
+        i->second.pin.reset();
+        HANDLE writable = ReOpenFile(original, DELETE | FILE_READ_ATTRIBUTES, 0,
+                                     FILE_FLAG_OPEN_REPARSE_POINT);
+        Handle file(writable == INVALID_HANDLE_VALUE ? nullptr : writable);
+        if (file && singleRegularFile(file.get()) &&
+            finalPath(file.get(), session().temp.volume) ==
+                    (session().temp.path / fs::u8path(i->first).filename()) &&
+            erase(file.get())) {
+            if (i->second.lease)
+                erase(i->second.lease.get());
+        }
+    }
+    images.erase(i);
+    return true;
+}
+void releaseAll() {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    while (!session().images.empty())
+        releaseLocked(session().images.begin()->first.c_str());
+}
+void initialize(const std::string& avd, const std::string& temp) {
+    auto& s = session();
+    s.descriptor = privateDescriptor();
+    s.temp = pinDirectory(temp);
+    s.avd = pinDirectory(avd);
+    std::atexit(releaseAll);
+    if (!s.avd.identified || !s.temp.identified)
+        return;
+    WIN32_FIND_DATAW entry;
+    HANDLE it = FindFirstFileW((s.avd.path / L"m*.tmp*.lease").c_str(), &entry);
+    if (it == INVALID_HANDLE_VALUE)
+        return;
+    do {
+        if (entry.dwFileAttributes &
+            (FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_DIRECTORY))
+            continue;
+        auto path = s.temp.path / entry.cFileName;
+        if (path.extension() == L".lease")
+            recover(path.replace_extension());
+    } while (FindNextFileW(it, &entry));
+    FindClose(it);
+}
+}  // namespace
+
+// mas-37's block layer uses PATH_MAX *bytes* (MAX_PATH on Windows), even for
+// an extended-length path. The cache's raw image and overlay must both fit.
+static fs::path usableDirectory(const std::string& longestLeaf) {
+    const auto& temp = session().temp;
+    for (const auto* dir : {&temp.path, &temp.dosPath}) {
+        if (!dir->empty() && (*dir / longestLeaf).u8string().size() < MAX_PATH)
+            return *dir;
+    }
+    return {};
+}
+
+static std::string compactStem(size_t value) {
+    // Same length as the original GetTempFileName stem. CREATE_NEW arbitrates
+    // collisions; a short name never grants ownership of an existing file.
+    constexpr char digits[] = "0123456789abcdefghijklmnopqrstuvwxyz";
+    std::string stem = "m000000";
+    for (size_t i = stem.size() - 1; i > 0; --i) {
+        stem[i] = digits[value % 36];
+        value /= 36;
+    }
+    return stem;
+}
+
+std::string create(const std::string& avd, const std::string& temp,
+                   const std::string& uuid, Kind kind) {
+    auto& s = session();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (!s.initialized) {
+        s.initialized = true;
+        s.avdInput = avd;
+        s.tempInput = temp;
+        initialize(avd, temp);
+    } else if (s.avdInput != avd || s.tempInput != temp) {
+        // Never redirect a live session to a different root or TEMP.
+        return {};
+    }
+    const char* extension = kind == Kind::DriveOverlay ? ".tmp.qcow2" : ".tmp";
+    const char* longest = kind == Kind::HardwareIni ? ".tmp" : ".tmp.qcow2";
+    std::string stem = "modavd-" + uuid;
+    auto dir = usableDirectory(stem + longest);
+    const bool compact = dir.empty();
+    if (compact)
+        dir = usableDirectory(std::string("m000000") + longest);
+    if (dir.empty())
+        return {};
+    const size_t seed = std::hash<std::string>{}(uuid);
+    for (unsigned attempt = 0; attempt < (compact ? 32u : 1u); ++attempt) {
+        if (compact)
+            stem = compactStem(seed + attempt);
+        const auto path = dir / (stem + extension);
+        auto result = reserve(path, false);
+        if (result == Reservation::Exists)
+            continue;
+        if (result != Reservation::Ready)
+            return {};
+        auto name = path.u8string();
+        if (kind != Kind::CachePair)
+            return name;
+        result = reserve(fs::path(path).concat(L".qcow2"), true);
+        if (result == Reservation::Ready)
+            return name;
+        releaseLocked(name.c_str());
+        if (result != Reservation::Exists)
+            return {};
+    }
+    return {};
+}
+
+bool takeReservedOverlay(const char* path) {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    auto& images = session().images;
+    auto i = images.find(path);
+    if (i == images.end() || !i->second.overlay)
+        return false;
+    i->second.overlay = false;
+    return true;
+}
+
+bool release(const char* path) {
+    std::lock_guard<std::mutex> lock(session().mutex);
+    return releaseLocked(path);
+}
+}  // namespace android::tempimages
+#endif
