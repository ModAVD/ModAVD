#include "test_support.h"
#include <deque>
using HWND = void*; using HDC = void*; using HPBUFFERARB = void*;
using DWORD = unsigned long;
constexpr DWORD ERROR_INVALID_HANDLE = 6;
static DWORD lastError = 0;
static void SetLastError(DWORD error) { lastError = error; }
static DWORD GetLastError() { return lastError; }
static HDC GetDC(HWND window) { return window; }
static int ReleaseDC(HWND, HDC) { return 1; }
namespace EglOS {
struct PixelFormat { virtual ~PixelFormat() = default; };
struct PbufferInfo {};
struct Surface {
    enum Type { WINDOW, PBUFFER };
    explicit Surface(Type type) : mType(type) {}
    virtual ~Surface() = default;
    Type type() const { return mType; }
    Type mType;
};
}
namespace gfxstream { namespace base { struct AutoLock { explicit AutoLock(int&) {} }; } }
static int sGlobalLock = 0;
struct WinPixelFormat : EglOS::PixelFormat {
    static const WinPixelFormat* from(const EglOS::PixelFormat* p) {
        return static_cast<const WinPixelFormat*>(p);
    }
    int configId() const { return 7; }
};
struct WinGlobals { HDC getDummyDC(const WinPixelFormat*) { return reinterpret_cast<HDC>(1); } };
static size_t nextId = 10, getCalls = 0, releaseCalls = 0, destroyCalls = 0;
static bool failRelease = false, failDestroy = false, failGet = false, failCreate = false;
static bool invalidDestroy = false;
static std::unordered_map<HPBUFFERARB, size_t> buffers;
static std::unordered_map<HPBUFFERARB, size_t> destroyAttempts;
static HPBUFFERARB createPb(HDC, int, int, int, const int*) {
    if (failCreate) { SetLastError(8); return nullptr; }
    auto pb = reinterpret_cast<HPBUFFERARB>(++nextId);
    buffers[pb] = 0;
    return pb;
}
static HDC getPb(HPBUFFERARB pb) {
    ++getCalls;
    if (failGet) { SetLastError(1425); return nullptr; }
    CHECK(buffers.count(pb));
    ++buffers[pb];
    return pb;
}
static int releasePb(HPBUFFERARB pb, HDC dc) {
    ++releaseCalls;
    if (failRelease) { SetLastError(1425); return 0; }
    CHECK(dc && buffers.count(pb) && buffers[pb]);
    --buffers[pb];
    return 1;
}
static int destroyPb(HPBUFFERARB pb) {
    ++destroyCalls;
    ++destroyAttempts[pb];
    if (invalidDestroy) { buffers.erase(pb); SetLastError(ERROR_INVALID_HANDLE); return 0; }
    if (failDestroy) { SetLastError(8); return 0; }
    CHECK(buffers.erase(pb) == 1);
    return 1;
}
struct WglExtensionsDispatch {
    HPBUFFERARB (*wglCreatePbuffer)(HDC, int, int, int, const int*) = createPb;
    HDC (*wglGetPbufferDC)(HPBUFFERARB) = getPb;
    int (*wglReleasePbufferDC)(HPBUFFERARB, HDC) = releasePb;
    int (*wglDestroyPbuffer)(HPBUFFERARB) = destroyPb;
    int (*wglSwapInterval)(int) = nullptr;
};
#define PROFILE_SLOW(...) ((void)0)

struct FakeClock {
    using time_point=std::chrono::steady_clock::time_point;
    inline static time_point time=time_point{}+std::chrono::minutes(2);
    static time_point now() { return time; }
};
using WglClock=FakeClock;
@WGL_LOG_LIMITER@
#ifdef HAS_WGL_FAILURE_LIMITER
static WglFailureLog sWglFailureLog;
#endif
@WIN_SURFACE@

struct ProbeDisplay {
    WglExtensionsDispatch dispatch;
    WglExtensionsDispatch* mDispatch = &dispatch;
    WinGlobals globals;
    WinGlobals* mGlobals = &globals;
    std::unordered_map<const EglOS::PixelFormat*, std::vector<EglOS::Surface*>> mFreePbufs;
    std::unordered_map<const EglOS::PixelFormat*, std::unordered_set<EglOS::Surface*>> mLivePbufs;
@PENDING_TYPE@
#ifdef HAS_BOUNDED_PBUFFERS
    std::deque<PendingPbuffer> mDeletePbufs;
    static EglOS::Surface* pendingSurface(const PendingPbuffer& pending) { return pending.surface; }
#else
    std::vector<EglOS::Surface*> mDeletePbufs;
#endif
    static EglOS::Surface* pendingSurface(EglOS::Surface* pending) { return pending; }
    uint64_t mPbufferAllocationLimit=0, mPbufferAllocationDenials=0;
    DWORD mLastPbufferDestroyError=0;
    HPBUFFERARB mLastFailedPbuffer=nullptr;
    std::array<uint64_t,11> mLastPbufferStats{};
@PBUFFER_LIMITS@
    uint64_t mPbuffersCreated = 0, mPbuffersDestroyed = 0, mPbufferReleaseFailures = 0;
    uint64_t mPbufferRefreshFailures = 0, mPbuffersInvalid = 0, mPbufferDestroyFailures = 0;
    std::chrono::steady_clock::time_point mLastPbufferLog{};
    static constexpr int kPbufPrimingCount = 8;

@CREATE_SURFACE@
@RELEASE_SURFACE@
@CREATE_IMPL@
@QUEUE_PENDING@
@LOG_STATS@

    ~ProbeDisplay() {
        for (auto& row : mFreePbufs) for (auto* p : row.second) {
            buffers.erase(WinSurface::from(p)->getPbuffer()); delete p;
        }
        for (auto& row : mLivePbufs) for (auto* p : row.second) {
            buffers.erase(WinSurface::from(p)->getPbuffer()); delete p;
        }
        for (auto pending : mDeletePbufs) { auto* p=pendingSurface(pending); buffers.erase(WinSurface::from(p)->getPbuffer()); delete p; }
    }
};
static void clearFailures() { failRelease = failDestroy = failGet = failCreate = invalidDestroy = false; }
int main() {
    WinPixelFormat format;
    WglExtensionsDispatch dispatch;
    {
        auto pb = createPb(nullptr, 7, 1, 1, nullptr);
        WinSurface surface(pb, &format, &dispatch);
        auto oldDC = surface.getDC();
        failRelease = true;
        CHECK(!surface.releaseDC());
        CHECK(surface.getDC() == oldDC);
        auto before = getCalls;
        CHECK(!surface.refreshDC());
        CHECK(getCalls == before);
        clearFailures();
        before = releaseCalls;
        CHECK(surface.releaseDC());
        CHECK(releaseCalls == before + 1 && surface.getDC() == nullptr);
        CHECK(destroyPb(pb));
    }
    std::puts("PASS WGL preserves failed DC and refresh does not overwrite it");
    {
        ProbeDisplay pool;
        for (int i = 0; i < 1000; ++i) {
            auto* pb = pool.createPbufferSurface(&format, nullptr);
            CHECK(pb && pool.releasePbuffer(pb));
        }
        CHECK(pool.mPbuffersCreated == 8 && pool.mLivePbufs[&format].empty());
        CHECK(pool.mFreePbufs[&format].size() == 8 && pool.mDeletePbufs.empty());
    }
    std::puts("PASS WGL normal pool remains bounded across 1000 uses");
    {
        ProbeDisplay pool;
        for (int i = 0; i < 1000; ++i) {
            auto* pb = pool.createPbufferSurface(&format, nullptr);
            CHECK(pb);
            failRelease = true;
            CHECK(!pool.releasePbuffer(pb));
            clearFailures();
            CHECK(pool.mLivePbufs[&format].empty() && pool.mDeletePbufs.empty());
        }
        CHECK(pool.mPbuffersDestroyed == 1000);
        CHECK(pool.mPbuffersCreated - pool.mPbuffersDestroyed == pool.mFreePbufs[&format].size());
    }
    std::puts("PASS WGL 1000 DC release failures retire instead of accumulating live pbuffers");
    {
        ProbeDisplay pool;
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        failRelease = failDestroy = true;
        CHECK(!pool.releasePbuffer(pb));
        CHECK(pool.mLivePbufs[&format].empty() && pool.mDeletePbufs.size() == 1);
        clearFailures();
        auto* next = pool.createPbufferSurface(&format, nullptr);
        CHECK(pool.mDeletePbufs.size() == 1); // preserve delayed destruction on Intel
        FakeClock::time+=std::chrono::seconds(1);
        CHECK(pool.releasePbuffer(next));
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersDestroyed == 1);
        CHECK(pool.releasePbuffer(pool.createPbufferSurface(&format, nullptr)));
        CHECK(pool.mPbuffersDestroyed == 1);
    }
    std::puts("PASS WGL failed native destruction remains owned and retries exactly once");
    {
        ProbeDisplay pool;
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        failRelease = invalidDestroy = true;
        CHECK(!pool.releasePbuffer(pb));
        clearFailures();
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersInvalid == 1);
    }
    std::puts("PASS WGL stale native handle drops its CPU record");
    {
        ProbeDisplay pool;
        failCreate = true;
        CHECK(!pool.createPbufferSurface(&format, nullptr));
        clearFailures();
        CHECK(pool.createPbufferSurface(&format, nullptr));
    }
    std::puts("PASS WGL native creation failure does not dereference an empty pool");
    {
        ProbeDisplay pool;
        failGet = true;
        CHECK(!pool.createPbufferSurface(&format, nullptr));
        CHECK(pool.mDeletePbufs.size() == 1);
        clearFailures();
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        CHECK(pb && pool.releasePbuffer(pb));
        CHECK(pool.mDeletePbufs.empty());
    }
    std::puts("PASS WGL failed initial DC acquisition retains ownership until a safe release");

#ifdef HAS_BOUNDED_PBUFFERS
    {
        ProbeDisplay pool;
        FakeClock::time+=std::chrono::minutes(1);
        logs.clear();
        auto* anchor=pool.createPbufferSurface(&format,nullptr); CHECK(anchor);
        failRelease=failDestroy=true;
        for(int i=0;i<1000;++i) {
            auto* pb=pool.createPbufferSurface(&format,nullptr);
            if(!pb)break;
            CHECK(!pool.releasePbuffer(pb));
        }
        CHECK(pool.mPbufferAllocationDenials && pool.mPbuffersCreated==pool.kPbufferBacklogBudget);
        CHECK(pool.mDeletePbufs.size()+1==pool.kPbufferBacklogBudget);
        CHECK(!pool.createPbufferSurface(&format,nullptr));
        failRelease=false;
        CHECK(pool.releasePbuffer(anchor));
        auto reuse=[&]{auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);CHECK(pool.releasePbuffer(pb));};
        for(int i=0;i<8;++i)reuse(); // ensure every queued entry has had an initial attempt
        for(auto& pending:pool.mDeletePbufs)CHECK(pending.retryAt>FakeClock::now());
        const auto before=destroyCalls;
        for(int i=0;i<10000;++i)reuse();
        CHECK(destroyCalls==before);
        std::unordered_map<HPBUFFERARB,size_t> attempts;
        for(auto& pending:pool.mDeletePbufs) {
            auto handle=WinSurface::from(pending.surface)->getPbuffer(); attempts[handle]=destroyAttempts[handle];
        }
        for(int i=0;i<8;++i) {
            FakeClock::time+=std::chrono::seconds(1);
            const auto previous=destroyCalls;
            reuse();CHECK(destroyCalls-previous<=pool.kPbufferRetryBatch);
        }
        for(auto& item:attempts)CHECK(destroyAttempts[item.first]>item.second);
        size_t errors=0;
        for(auto& line:logs)if(line.find("MAS: native pbuffers ")!=0)++errors;
        CHECK(errors<=3);
        clearFailures(); FakeClock::time+=std::chrono::seconds(1);
        for(int i=0;i<8 && !pool.mDeletePbufs.empty();++i)reuse();
        CHECK(pool.mDeletePbufs.empty() && !pool.mPbufferAllocationLimit);
        CHECK(pool.mPbuffersDestroyed+pool.mFreePbufs[&format].size()==pool.mPbuffersCreated);
        std::vector<EglOS::Surface*> healthy;
        for(int i=0;i<70;++i){auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);healthy.push_back(pb);}
        CHECK(pool.mPbuffersCreated-pool.mPbuffersDestroyed>pool.kPbufferBacklogBudget);
        for(auto* pb:healthy)CHECK(pool.releasePbuffer(pb));
    }
    std::puts("PASS persistent WGL destruction failure bounds allocation and pauses retries within one second");
    std::puts("PASS WGL retry batches are bounded and fair, details are throttled, recovery lifts the allocation limit");
    {
        ProbeDisplay pool;
        failGet=true;
        for(int i=0;i<1000;++i)CHECK(!pool.createPbufferSurface(&format,nullptr));
        CHECK(pool.mPbuffersCreated==pool.kPbufferBacklogBudget);
        CHECK(pool.mDeletePbufs.size()==pool.kPbufferBacklogBudget);
        clearFailures();
    }
    std::puts("PASS repeated initial DC acquisition failures cannot allocate an unbounded pending queue");
    {
        ProbeDisplay pool;
        std::vector<EglOS::Surface*> active;
        for(int i=0;i<80;++i){auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);active.push_back(pb);}
        const auto owned=pool.mPbuffersCreated;
        CHECK(owned>pool.kPbufferBacklogBudget);
        failRelease=failDestroy=true;
        for(auto* pb:active)pool.releasePbuffer(pb);
        CHECK(pool.mPbufferAllocationLimit==owned && pool.mDeletePbufs.size()==active.size());
        failGet=true;
        for(int i=0;i<1000;++i)CHECK(!pool.createPbufferSurface(&format,nullptr));
        CHECK(pool.mPbuffersCreated==owned && pool.mDeletePbufs.size()==owned);
        clearFailures();
    }
    std::puts("PASS backlog budget preserves ownership of objects that were already live above the reserve");
    {
        ProbeDisplay pool;
        auto* pb=pool.createPbufferSurface(&format,nullptr); CHECK(pb && pool.releasePbuffer(pb));
        FakeClock::time+=std::chrono::minutes(1); pool.logPbufferStatsLocked();
        const auto before=logs.size();
        FakeClock::time+=std::chrono::minutes(1); pool.logPbufferStatsLocked();
        CHECK(logs.size()==before);
    }
    std::puts("PASS unchanged native pbuffer summaries remain silent across minute boundaries");
#endif
    CHECK(buffers.empty());
}
