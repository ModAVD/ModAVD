#include "test_support.h"
#include <deque>
#include <variant>
using HWND = void*; using HDC = void*; using HPBUFFERARB = void*;
using DWORD = unsigned long;
constexpr DWORD ERROR_INVALID_HANDLE = 6;
#define HRESULT_CODE(error) ((error) & 0xffff)
static DWORD lastError = 0;
static void SetLastError(DWORD error) { lastError = error; }
static DWORD GetLastError() { return lastError; }
static HDC GetDC(HWND window) { return window; }
static int ReleaseDC(HWND, HDC) { return 1; }
namespace EglOS {
struct PixelFormat { virtual ~PixelFormat() = default; };
struct PbufferInfo {};
struct Surface {
    enum Type { WINDOW, PBUFFER };
    explicit Surface(Type type) : mType(type) {}
    virtual ~Surface() = default;
    Type type() const { return mType; }
    Type mType;
};
}
namespace gfxstream { namespace base { struct AutoLock { explicit AutoLock(int&) {} }; } }
static int sGlobalLock = 0;
struct WinPixelFormat : EglOS::PixelFormat {
    static const WinPixelFormat* from(const EglOS::PixelFormat* p) {
        return static_cast<const WinPixelFormat*>(p);
    }
    int configId() const { return 7; }
};
struct WinGlobals { HDC getDummyDC(const WinPixelFormat*) { return reinterpret_cast<HDC>(1); } };
static size_t nextId = 10, getCalls = 0, releaseCalls = 0, destroyCalls = 0;
static bool failRelease = false, failDestroy = false, failGet = false, failCreate = false;
static bool invalidDestroy = false;
static DWORD invalidDestroyError=ERROR_INVALID_HANDLE;
static size_t failGetCount=0;
static std::unordered_map<HPBUFFERARB, size_t> buffers;
static std::unordered_map<HPBUFFERARB, size_t> destroyAttempts;
static HPBUFFERARB createPb(HDC, int, int, int, const int*) {
    if (failCreate) { SetLastError(8); return nullptr; }
    auto pb = reinterpret_cast<HPBUFFERARB>(++nextId);
    buffers[pb] = 0;
    return pb;
}
static HDC getPb(HPBUFFERARB pb) {
    ++getCalls;
    if (failGet || failGetCount) { if(failGetCount)--failGetCount; SetLastError(1425); return nullptr; }
    CHECK(buffers.count(pb));
    ++buffers[pb];
    return pb;
}
static int releasePb(HPBUFFERARB pb, HDC dc) {
    ++releaseCalls;
    if (failRelease) { SetLastError(1425); return 0; }
    CHECK(dc && buffers.count(pb) && buffers[pb]);
    --buffers[pb];
    return 1;
}
static int destroyPb(HPBUFFERARB pb) {
    ++destroyCalls;
    ++destroyAttempts[pb];
    if (invalidDestroy) { buffers.erase(pb); SetLastError(invalidDestroyError); return 0; }
    if (failDestroy) { SetLastError(8); return 0; }
    CHECK(buffers.erase(pb) == 1);
    return 1;
}
struct WglExtensionsDispatch {
    HPBUFFERARB (*wglCreatePbuffer)(HDC, int, int, int, const int*) = createPb;
    HDC (*wglGetPbufferDC)(HPBUFFERARB) = getPb;
    int (*wglReleasePbufferDC)(HPBUFFERARB, HDC) = releasePb;
    int (*wglDestroyPbuffer)(HPBUFFERARB) = destroyPb;
    int (*wglSwapInterval)(int) = nullptr;
};
#define PROFILE_SLOW(...) ((void)0)

struct FakeClock {
    using time_point=std::chrono::steady_clock::time_point;
    inline static time_point time=time_point{}+std::chrono::minutes(2);
    static time_point now() { return time; }
};
using WglClock=FakeClock;
@WGL_FAILURE_KIND@
@WGL_LOG_LIMITER@
#ifdef HAS_WGL_FAILURE_LIMITER
static WglFailureLog sWglFailureLog;
#endif
@WIN_SURFACE@

struct ProbeDisplay {
    WglExtensionsDispatch dispatch;
    WglExtensionsDispatch* mDispatch = &dispatch;
    WinGlobals globals;
    WinGlobals* mGlobals = &globals;
    std::unordered_map<const EglOS::PixelFormat*, std::vector<EglOS::Surface*>> mFreePbufs;
    std::unordered_map<const EglOS::PixelFormat*, std::unordered_set<EglOS::Surface*>> mLivePbufs;
@PENDING_TYPE@
#ifdef HAS_BOUNDED_PBUFFERS
    std::deque<PendingPbuffer> mDeletePbufs;
    static EglOS::Surface* pendingSurface(const PendingPbuffer& pending) { return pending.surface; }
#else
    std::vector<EglOS::Surface*> mDeletePbufs;
#endif
    static EglOS::Surface* pendingSurface(EglOS::Surface* pending) { return pending; }
    uint64_t mPbufferAllocationLimit=0, mPbuffersAbandoned=0, mPbufferAllocationDenials=0, mPbufferQueueEvictions=0;
    DWORD mLastPbufferDestroyError=0;
    HPBUFFERARB mLastFailedPbuffer=nullptr;
    std::array<uint64_t,11> mLastPbufferStats{};
@PBUFFER_LIMITS@
    uint64_t mPbuffersCreated = 0, mPbuffersDestroyed = 0, mPbufferReleaseFailures = 0;
    uint64_t mPbufferRefreshFailures = 0, mPbuffersInvalid = 0, mPbufferDestroyFailures = 0;
    std::chrono::steady_clock::time_point mLastPbufferLog{};
    static constexpr int kPbufPrimingCount = 8;

@CREATE_SURFACE@
@RELEASE_SURFACE@
@CREATE_RESULT@
@CREATE_IMPL@
@ABANDON_PBUFFER@
@EXPIRE_PBUFFERS@
@QUEUE_PENDING@
@LOG_STATS@

    ~ProbeDisplay() {
        for (auto& row : mFreePbufs) for (auto* p : row.second) {
            buffers.erase(WinSurface::from(p)->getPbuffer()); delete p;
        }
        for (auto& row : mLivePbufs) for (auto* p : row.second) {
            buffers.erase(WinSurface::from(p)->getPbuffer()); delete p;
        }
        for (auto pending : mDeletePbufs) { auto* p=pendingSurface(pending); buffers.erase(WinSurface::from(p)->getPbuffer()); delete p; }
    }
};
static void clearFailures() { failRelease = failDestroy = failGet = failCreate = invalidDestroy = false; failGetCount=0; invalidDestroyError=ERROR_INVALID_HANDLE; }
static void testPoolFallback() {
    WinPixelFormat format;
    ProbeDisplay pool;
    std::vector<EglOS::Surface*> active;
    for(int i=0;i<80;++i){auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);active.push_back(pb);}
    for(auto* pb:active)CHECK(pool.releasePbuffer(pb));
    CHECK(pool.mFreePbufs[&format].size()>64);
    const auto created=nextId;
    failGetCount=1;
    auto* pb=pool.createPbufferSurface(&format,nullptr);
    CHECK(pb); // one bad cached object cannot hide the other healthy free objects
    CHECK(nextId==created);
    CHECK(pool.mDeletePbufs.size()==1);
    CHECK(pool.releasePbuffer(pb));
    CHECK(pool.mDeletePbufs.empty());
    std::puts("PASS a single refresh failure in a pool larger than 64 reuses a healthy free surface");
}
static void testInitialDcFailure() {
    WinPixelFormat format;
    ProbeDisplay pool;
    failGetCount=1;
    auto* pb=pool.createPbufferSurface(&format,nullptr);
    CHECK(pb); // a transient first DC failure must not end the bounded priming batch
    CHECK(pool.mDeletePbufs.size()==1);
    CHECK(pool.releasePbuffer(pb));
    CHECK(pool.mDeletePbufs.empty());
    std::puts("PASS one initial DC acquisition failure continues priming and returns a surface");
}
static void testFullQueueRecovery() {
    WinPixelFormat format;
    ProbeDisplay pool;
    failGet=true;
    for(int i=0;i<8;++i)CHECK(!pool.createPbufferSurface(&format,nullptr));
    CHECK(pool.mDeletePbufs.size()==64);
    clearFailures();
    auto* pb=pool.createPbufferSurface(&format,nullptr);
    CHECK(pb); // recovery cannot wait for a software backlog deadline
    CHECK(pool.releasePbuffer(pb));
    for(int i=0;i<8 && !pool.mDeletePbufs.empty();++i){auto* next=pool.createPbufferSurface(&format,nullptr);CHECK(next && pool.releasePbuffer(next));}
    CHECK(pool.mDeletePbufs.empty() && !pool.mPbuffersAbandoned);
    std::puts("PASS a recovered driver creates surfaces immediately even with a full retired queue");
}
int main(int argc,char** argv) {
    if(argc>1) {
        const std::string test=argv[1];
        if(test=="pool-fallback")testPoolFallback();
        else if(test=="initial-dc")testInitialDcFailure();
        else if(test=="full-recovery")testFullQueueRecovery();
        else CHECK(false);
        return 0;
    }
    WinPixelFormat format;
    WglExtensionsDispatch dispatch;
    {
        auto pb = createPb(nullptr, 7, 1, 1, nullptr);
        WinSurface surface(pb, &format, &dispatch);
        auto oldDC = surface.getDC();
        failRelease = true;
        CHECK(!surface.releaseDC());
        CHECK(surface.getDC() == oldDC);
        auto before = getCalls;
        CHECK(!surface.refreshDC());
        CHECK(getCalls == before);
        clearFailures();
        before = releaseCalls;
        CHECK(surface.releaseDC());
        CHECK(releaseCalls == before + 1 && surface.getDC() == nullptr);
        CHECK(destroyPb(pb));
    }
    std::puts("PASS WGL preserves failed DC and refresh does not overwrite it");
    {
        ProbeDisplay pool;
        for (int i = 0; i < 1000; ++i) {
            auto* pb = pool.createPbufferSurface(&format, nullptr);
            CHECK(pb && pool.releasePbuffer(pb));
        }
        CHECK(pool.mPbuffersCreated == 8 && pool.mLivePbufs[&format].empty());
        CHECK(pool.mFreePbufs[&format].size() == 8 && pool.mDeletePbufs.empty());
    }
    std::puts("PASS WGL normal pool remains bounded across 1000 uses");
    {
        ProbeDisplay pool;
        for (int i = 0; i < 1000; ++i) {
            auto* pb = pool.createPbufferSurface(&format, nullptr);
            CHECK(pb);
            failRelease = true;
            CHECK(!pool.releasePbuffer(pb));
            clearFailures();
            CHECK(pool.mLivePbufs[&format].empty() && pool.mDeletePbufs.empty());
        }
        CHECK(pool.mPbuffersDestroyed == 1000);
        CHECK(pool.mPbuffersCreated - pool.mPbuffersDestroyed == pool.mFreePbufs[&format].size());
    }
    std::puts("PASS WGL 1000 DC release failures retire instead of accumulating live pbuffers");
    {
        ProbeDisplay pool;
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        failRelease = failDestroy = true;
        CHECK(!pool.releasePbuffer(pb));
        CHECK(pool.mLivePbufs[&format].empty() && pool.mDeletePbufs.size() == 1);
        clearFailures();
        auto* next = pool.createPbufferSurface(&format, nullptr);
        CHECK(pool.mDeletePbufs.size() == 1); // preserve delayed destruction on Intel
        FakeClock::time+=std::chrono::seconds(1);
        CHECK(pool.releasePbuffer(next));
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersDestroyed == 1);
        CHECK(pool.releasePbuffer(pool.createPbufferSurface(&format, nullptr)));
        CHECK(pool.mPbuffersDestroyed == 1);
    }
    std::puts("PASS WGL failed native destruction remains owned and retries exactly once");
    {
        ProbeDisplay pool;
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        failRelease = invalidDestroy = true;
        CHECK(!pool.releasePbuffer(pb));
        clearFailures();
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersInvalid == 1);
    }
    std::puts("PASS WGL stale native handle drops its CPU record");
    {
        ProbeDisplay pool;
        failCreate = true;
        CHECK(!pool.createPbufferSurface(&format, nullptr));
        clearFailures();
        CHECK(pool.createPbufferSurface(&format, nullptr));
    }
    std::puts("PASS WGL native creation failure does not dereference an empty pool");
    {
        ProbeDisplay pool;
        failGet = true;
        CHECK(!pool.createPbufferSurface(&format, nullptr));
        CHECK(pool.mDeletePbufs.size() == pool.kPbufPrimingCount);
        clearFailures();
        auto* pb = pool.createPbufferSurface(&format, nullptr);
        CHECK(pb && pool.releasePbuffer(pb));
        CHECK(pool.mDeletePbufs.empty());
    }
    std::puts("PASS WGL failed initial DC acquisition retains ownership until a safe release");

    testPoolFallback();
    testInitialDcFailure();
    testFullQueueRecovery();
#ifdef HAS_WGL_FAILURE_KINDS
    {
        ProbeDisplay pool;
        FakeClock::time+=std::chrono::minutes(1);logs.clear();
        auto* anchor=pool.createPbufferSurface(&format,nullptr);CHECK(anchor);
        failDestroy=true;
        for(size_t i=0;i<pool.kPbufferBacklogBudget;++i) {
            failRelease=false;
            auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);
            failRelease=true;CHECK(!pool.releasePbuffer(pb));
        }
        CHECK(pool.mDeletePbufs.size()==pool.kPbufferBacklogBudget);
        failRelease=false;
        std::vector<EglOS::Surface*> healthy;
        while(!pool.mFreePbufs[&format].empty()) {
            auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);healthy.push_back(pb);
        }
        const auto created=nextId;
        auto* extra=pool.createPbufferSurface(&format,nullptr);CHECK(extra);
        CHECK(nextId>created && !pool.mPbufferQueueEvictions);
        healthy.push_back(extra);
        CHECK(pool.releasePbuffer(anchor));
        for(auto* pb:healthy)CHECK(pool.releasePbuffer(pb));
        auto reuse=[&]{auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);CHECK(pool.releasePbuffer(pb));};
        for(int i=0;i<8;++i)reuse();
        for(auto& pending:pool.mDeletePbufs)CHECK(pending.retryAt>FakeClock::now());
        const auto before=destroyCalls;
        for(int i=0;i<10000;++i)reuse();
        CHECK(destroyCalls==before);
        std::unordered_map<HPBUFFERARB,size_t> attempts;
        for(auto& pending:pool.mDeletePbufs){auto handle=WinSurface::from(pending.surface)->getPbuffer();attempts[handle]=destroyAttempts[handle];}
        for(int i=0;i<8;++i) {
            FakeClock::time+=std::chrono::seconds(1);
            const auto previous=destroyCalls;reuse();CHECK(destroyCalls-previous<=pool.kPbufferRetryBatch);
        }
        for(auto& item:attempts)CHECK(destroyAttempts[item.first]>item.second);
        size_t releaseDetails=0,destroyDetails=0;
        for(auto& line:logs) {
            if(line.find("MAS: wglReleasePbufferDC(")==0)++releaseDetails;
            if(line.find("MAS: wglDestroyPbuffer(")==0)++destroyDetails;
        }
        CHECK(releaseDetails<=3 && destroyDetails==3);
        clearFailures();FakeClock::time+=std::chrono::seconds(1);
        for(int i=0;i<8 && !pool.mDeletePbufs.empty();++i)reuse();
        CHECK(pool.mDeletePbufs.empty() && !pool.mPbuffersAbandoned);
        CHECK(pool.mPbuffersDestroyed+pool.mFreePbufs[&format].size()==pool.mPbuffersCreated);
    }
    std::puts("PASS a full pending queue permits both healthy cached reuse and fresh native allocation");
    std::puts("PASS native destruction retries stay bounded and fair without changing healthy creation");
    {
        ProbeDisplay pool;
        auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);
        failRelease=true;invalidDestroy=true;invalidDestroyError=0xc0070006ul;
        CHECK(!pool.releasePbuffer(pb));clearFailures();
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersInvalid==1 && !pool.mPbuffersAbandoned);
        FakeClock::time+=std::chrono::seconds(600);
        std::vector<EglOS::Surface*> active;
        for(int i=0;i<200;++i){auto* next=pool.createPbufferSurface(&format,nullptr);CHECK(next);active.push_back(next);}
        for(auto* next:active)CHECK(pool.releasePbuffer(next));
    }
    std::puts("PASS HRESULT-wrapped invalid handles retire immediately and never block later window creation");
    {
        ProbeDisplay pool;
        auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);
        const auto leaked=WinSurface::from(pb)->getPbuffer();
        failRelease=failDestroy=true;CHECK(!pool.releasePbuffer(pb));failRelease=false;
        for(unsigned i=1;i<pool.kMaxPbufferRetries;++i) {
            FakeClock::time+=std::chrono::seconds(1);
            auto* next=pool.createPbufferSurface(&format,nullptr);CHECK(next && pool.releasePbuffer(next));
        }
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersAbandoned==1);
        CHECK(destroyAttempts[leaked]==pool.kMaxPbufferRetries && buffers.count(leaked));
        CHECK(pool.mPbuffersCreated-pool.mPbuffersDestroyed-pool.mPbuffersInvalid-pool.mPbuffersAbandoned==pool.mFreePbufs[&format].size());
        const auto before=destroyCalls;FakeClock::time+=std::chrono::seconds(600);
        std::vector<EglOS::Surface*> active;
        for(int i=0;i<200;++i){auto* next=pool.createPbufferSurface(&format,nullptr);CHECK(next);active.push_back(next);}
        clearFailures();for(auto* next:active)CHECK(pool.releasePbuffer(next));
        CHECK(destroyCalls==before);
        buffers.erase(leaked); // native ownership was explicitly abandoned; simulate process teardown
    }
    std::puts("PASS permanent native destruction failure stops after eight attempts and is counted as a possible leak");
    {
        ProbeDisplay pool;
        failGet=true;
        for(int i=0;i<8;++i)CHECK(!pool.createPbufferSurface(&format,nullptr));
        CHECK(pool.mPbuffersCreated==pool.kPbufferBacklogBudget && pool.mDeletePbufs.size()==pool.kPbufferBacklogBudget);
        std::vector<HPBUFFERARB> leaked;
        for(auto& pending:pool.mDeletePbufs)leaked.push_back(WinSurface::from(pending.surface)->getPbuffer());
        clearFailures();FakeClock::time+=pool.kPbufferLifetime;
        const auto before=destroyCalls;
        auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);
        CHECK(pool.mDeletePbufs.empty() && pool.mPbuffersAbandoned==leaked.size());
        CHECK(destroyCalls==before); // expiry frees CPU records, never native destroy on creation/Intel path
        CHECK(pool.releasePbuffer(pb));
        for(auto handle:leaked){CHECK(buffers.count(handle));buffers.erase(handle);}
    }
    std::puts("PASS a full backlog with no live surface expires without native calls and admits a recovered driver");
    {
        ProbeDisplay pool;
        std::vector<EglOS::Surface*> active;
        for(int i=0;i<80;++i){auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb);active.push_back(pb);}
        FakeClock::time+=std::chrono::minutes(1);logs.clear();
        std::vector<HPBUFFERARB> retired;
        failRelease=failDestroy=true;
        for(auto* pb:active){retired.push_back(WinSurface::from(pb)->getPbuffer());CHECK(!pool.releasePbuffer(pb));}
        CHECK(pool.mDeletePbufs.size()==pool.kPbufferBacklogBudget);
        CHECK(pool.mPbuffersAbandoned==active.size()-pool.kPbufferBacklogBudget);
        CHECK(pool.mPbufferQueueEvictions==pool.mPbuffersAbandoned);
        size_t destroyDetails=0,queueDetails=0;
        for(auto& line:logs){if(line.find("MAS: wglDestroyPbuffer(")==0)++destroyDetails;if(line.find("MAS: pbuffer backlog full:")==0)++queueDetails;}
        CHECK(destroyDetails==3 && queueDetails==3);
        size_t dropped=0;
        for(auto handle:retired){bool tracked=false;for(auto& pending:pool.mDeletePbufs)if(WinSurface::from(pending.surface)->getPbuffer()==handle)tracked=true;if(!tracked){CHECK(buffers.count(handle));buffers.erase(handle);++dropped;}}
        CHECK(dropped==pool.mPbuffersAbandoned);
        clearFailures();FakeClock::time+=std::chrono::seconds(1);
        for(int i=0;i<8 && !pool.mDeletePbufs.empty();++i){auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb && pool.releasePbuffer(pb));}
        CHECK(pool.mDeletePbufs.empty());
    }
    std::puts("PASS queue overflow is independently logged and every dropped CPU record is counted as a possible native leak");
    {
        FakeClock::time+=std::chrono::minutes(1);
        WglFailureLog limiter;
        for(size_t i=0;i<static_cast<size_t>(WglFailure::Count);++i) {
            const auto kind=static_cast<WglFailure>(i);
            for(int j=0;j<3;++j)CHECK(limiter.allow(kind));
            CHECK(!limiter.allow(kind));
        }
        FakeClock::time+=std::chrono::minutes(1);
        CHECK(limiter.allow(WglFailure::Destroy) && limiter.allow(WglFailure::@BACKLOG_LOG_KIND@));
    }
    std::puts("PASS WGL failure reasons keep independent detail budgets across minute boundaries");
    {
        ProbeDisplay pool;
        auto* pb=pool.createPbufferSurface(&format,nullptr);CHECK(pb && pool.releasePbuffer(pb));
        FakeClock::time+=std::chrono::minutes(1);pool.logPbufferStatsLocked();
        const auto before=logs.size();FakeClock::time+=std::chrono::minutes(1);pool.logPbufferStatsLocked();
        CHECK(logs.size()==before);
    }
    std::puts("PASS unchanged native pbuffer summaries remain silent across minute boundaries");
#endif
    CHECK(buffers.empty());
}
