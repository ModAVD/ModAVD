using namespace gfxstream::host;
namespace gfxstream { class Stream {}; namespace base { using AutoLock = std::unique_lock<std::mutex>; } }
struct CpuOwner {
    inline static std::atomic<int> alive{0};
    CpuOwner() { ++alive; }
    virtual ~CpuOwner() { --alive; }
};
static thread_local unsigned currentNative=0, expectedNative=0;
static thread_local unsigned glCalls=0, foreignGlCalls=0, nativeDeletes=0;
static void noteGl() { ++glCalls; if (currentNative != expectedNative) ++foreignGlCalls; }
struct GLDispatch {
    bool isInitialized() { return true; }
    bool glIsProgram(GLuint) { noteGl(); return true; }
    void glGetIntegerv(GLenum, GLint* out) { noteGl(); *out=0; }
#define GL_CALL(name) template<class... Args> void name(Args...) { noteGl(); }
    GL_CALL(glDeleteProgram) GL_CALL(glDeleteShader) GL_CALL(glDeleteTextures)
    GL_CALL(glDeleteBuffers) GL_CALL(glDeleteRenderbuffers) GL_CALL(glDeleteFramebuffers)
    GL_CALL(glDeleteVertexArrays) GL_CALL(glDeleteSamplers) GL_CALL(glDeleteQueries)
    GL_CALL(glDeleteTransformFeedbacks) GL_CALL(glBindFramebuffer) GL_CALL(glBindVertexArray)
    GL_CALL(glFramebufferRenderbuffer) GL_CALL(glFramebufferTexture2D)
#undef GL_CALL
};
static GLDispatch s_glDispatch;
struct GLEScontext;
struct GlLibrary;
using ImagePtr=std::shared_ptr<int>;
@EGL_IFACE@
static EGLiface* s_eglIface=nullptr;
struct GlobalNameSpace { std::mutex m_lock; };
static GlobalNameSpace globalNames;
@NAMED_TYPE@
struct NamedObject : CpuOwner {
    explicit NamedObject(NamedObjectType type) : m_type(type) {}
    ~NamedObject();
    GLuint m_globalName=3;
    NamedObjectType m_type;
    GlobalNameSpace* m_globalNameSpace=&globalNames;
};
using NamedObjectPtr=std::shared_ptr<NamedObject>;
struct ObjectData : CpuOwner { virtual ~ObjectData() = default; };
using ObjectDataPtr=std::shared_ptr<ObjectData>;
struct RenderbufferData : ObjectData { unsigned attachedFB=7, attachedPoint=8; };
struct FramebufferData : ObjectData {
    static constexpr int MAX_ATTACH_POINTS=4;
    struct Attachment {
        GLenum target=0;
        GLuint name=0;
        NamedObjectType objType=NamedObjectType::NULLTYPE;
        ObjectDataPtr obj;
        bool owned=false;
        GLuint globalName=0;
    };
    Attachment m_attachPoints[MAX_ATTACH_POINTS];
    bool m_hasSeparateDepthStencil=false;
    GLuint m_separateDSEmulationRbo=16, m_fbGlobalName=17;
    static int attachmentPointIndex(GLenum point) { return point==GL_DEPTH_ATTACHMENT?1:2; }
    ~FramebufferData();
    void detachObject(int idx);
    void refreshSeparateDepthStencilAttachmentState();
};
struct NameSpace : CpuOwner {
    explicit NameSpace(NamedObjectType type) { names.emplace_back(std::make_shared<NamedObject>(type)); }
    std::vector<NamedObjectPtr> names;
    std::vector<ObjectDataPtr> data;
    void deleteName(unsigned) { names.clear(); }
};
struct ShareGroup : CpuOwner {
    NamedObjectPtr texture=std::make_shared<NamedObject>(NamedObjectType::TEXTURE);
    unsigned getId() const { return 1; }
};
using ShareGroupPtr=std::shared_ptr<ShareGroup>;
struct Arrays { std::unique_ptr<std::unordered_map<unsigned,CpuOwner*>> arraysMap; };
struct GLEScontext : CpuOwner {
    GLEScontext() {
        m_fboNameSpace=new NameSpace(NamedObjectType::FRAMEBUFFER);
        m_fboNameSpace->data.emplace_back(std::make_shared<FramebufferData>());
        auto fb=std::static_pointer_cast<FramebufferData>(m_fboNameSpace->data[0]);
        fb->m_attachPoints[0]={GL_TEXTURE_2D,23,NamedObjectType::TEXTURE,std::make_shared<ObjectData>(),true,23};
        fb->m_attachPoints[1]={GL_RENDERBUFFER_OES,24,NamedObjectType::RENDERBUFFER,std::make_shared<RenderbufferData>(),true,24};
        m_vaoNameSpace=new NameSpace(NamedObjectType::VERTEX_ARRAY_OBJECT);
        auto& arrays=m_vaoStateMap[0].arraysMap;
        arrays=std::make_unique<std::unordered_map<unsigned,CpuOwner*>>();
        arrays->emplace(1,new CpuOwner());
    }
    virtual ~GLEScontext();
    static GLDispatch& dispatcher() { return s_glDispatch; }
    static bool isNativeGlCleanupAllowed();
    void deleteVAO(unsigned name) { m_vaoNameSpace->deleteName(name); }
    void setShareGroup(ShareGroupPtr group) { m_shareGroup=std::move(group); }
    struct Blit { GLuint program=1,tex=2,vao=3,vbo=4,fbo=5; } m_blitState;
    GLuint m_textureEmulationProg=6, m_textureEmulationTextures[2]={7,8};
    GLuint m_textureEmulationFBO=9, m_textureEmulationVAO=10, m_defaultFBO=11,m_defaultReadFBO=12;
    CpuOwner* m_texState=new CpuOwner[2];
    std::unordered_map<unsigned,Arrays> m_vaoStateMap;
    NameSpace* m_fboNameSpace=nullptr;
    NameSpace* m_vaoNameSpace=nullptr;
    ShareGroupPtr m_shareGroup;
};
struct GLESv2Context : GLEScontext {
    ~GLESv2Context();
    GLuint m_emulatedClientIBO=13;
    std::vector<GLuint> m_emulatedClientVBOs{14,15};
    NameSpace* m_transformFeedbackNameSpace=new NameSpace(NamedObjectType::TRANSFORM_FEEDBACK);
};
struct CoreProfileEngine : CpuOwner {
    struct State { GLuint program=1, programFlat=2,vao=3,ibo=4,vbo=5,posVbo=6,normalVbo=7,colorVbo=8,pointsizeVbo=9,texcoordVbo=10; };
    State m_drawTexOESCoreState,m_geometryDrawState;
    ~CoreProfileEngine();
    void teardown();
};
struct GLEScmContext : GLEScontext {
    GLEScmContext() {
        m_currVaoState.arrays=m_vaoStateMap[0].arraysMap.get();
        m_currVaoState[GL_TEXTURE_COORD_ARRAY]=m_texCoords;
    }
    ~GLEScmContext();
    struct VaoRef {
        std::unordered_map<unsigned,CpuOwner*>* arrays=nullptr;
        CpuOwner*& operator[](unsigned key) { return (*arrays)[key]; }
    } m_currVaoState;
    CpuOwner* m_texCoords=new CpuOwner[2];
    CoreProfileEngine* m_coreProfileEngine=new CoreProfileEngine();
};
@GLES_POLICY@
@NAMED_DTOR@
@FBO_DTOR@
@FBO_DETACH@
@FBO_REFRESH@
@GLES_DTOR@
@GLES_V2_DTOR@
@GLES_CM_DTOR@
@CM_CORE_DTOR@
@CM_CORE_TEARDOWN@

namespace EglOS {
struct Surface {};
struct Context {
    explicit Context(unsigned value) : id(value) {}
    ~Context() { ++nativeDeletes; }
    unsigned id;
};
struct PbufferInfo { int width=0,height=0,largest=0,target=0,format=0; bool hasMipmap=false; };
}
struct EglSurface : CpuOwner {
    EglOS::Surface* native() const { return pb; }
    EglOS::Surface* pb=nullptr;
};
using SurfacePtr=std::shared_ptr<EglSurface>;
struct EglContext;
struct EglDisplay;
using ContextPtr=std::shared_ptr<EglContext>;
static std::unordered_set<GLEScontext*> deletedGlesOwners;
struct ObjectNameManager {
    std::unordered_map<void*,ShareGroupPtr> groups;
    void deleteShareGroup(void* key) { groups.erase(key); }
};
@THREAD_INFO@
static thread_local ThreadInfo s_threadInfo;
static ThreadInfo* getThreadInfo() { return &s_threadInfo; }
@CLEANUP_SCOPE@
@EGL_POLICY@
struct EglConfig { int nativeFormat() const { return 0; } };
struct NativeDisplay {
    bool failPbuffer=false,failBind=false,failRestore=false,clearFailedBind=false;
    unsigned createCalls=0,bindCalls=0,pbuffersReleased=0;
    EglOS::Surface pb;
    EglOS::Surface* createPbufferSurface(int, EglOS::PbufferInfo*) { ++createCalls; return failPbuffer?nullptr:&pb; }
    bool makeCurrent(EglOS::Surface*,EglOS::Surface*,EglOS::Context* context) {
        ++bindCalls;
        unsigned id=context?context->id:0;
        if ((id==1 && failBind) || (id==2 && failRestore)) {
            if(clearFailedBind)currentNative=0;
            return false;
        }
        currentNative=id;
        return true;
    }
};
using GLESVersion=int;
constexpr GLESVersion GLES_1_1=1,GLES_2_0=2,GLES_3_0=3,GLES_3_1=4;
struct EglDisplay {
    NativeDisplay native;
    EglConfig config;
    ObjectNameManager manager;
    ContextPtr caller,added;
    bool failNative=false;
    unsigned nextNative=1;
    NativeDisplay* nativeType() { return &native; }
    EglConfig* getConfig(EGLConfig) { return &config; }
    ContextPtr getContext(EGLContext ctx);
    ObjectNameManager* getManager(GLESVersion) { return &manager; }
    GlobalNameSpace* getGlobalNameSpace() { return &globalNames; }
    EGLContext addContext(ContextPtr ctx) { added=ctx; return reinterpret_cast<EGLContext>(1); }
};
struct EglPbufferSurface : EglSurface {
    EglPbufferSurface(EglDisplay* display,EglConfig*) : dpy(display) {}
    ~EglPbufferSurface() { if(pb)++dpy->native.pbuffersReleased; }
    void setAttrib(EGLint,EGLint) {}
    void getDim(int*,int*,int*) {}
    void getTexInfo(int*,int*) {}
    void setNativePbuffer(EglOS::Surface* value) { pb=value; }
    EglDisplay* dpy;
};
struct EglContext {
    EglContext(EglDisplay* display,uint64_t,EglConfig* config,GLEScontext* gles,GLESVersion version,int,ObjectNameManager* manager,gfxstream::Stream*)
        : m_dpy(display),m_config(config),m_glesContext(gles),m_version(version),m_mngr(manager) {
        deletedGlesOwners.erase(gles);
        if (!display->failNative) {
            m_native=std::make_shared<EglOS::Context>(display->nextNative++);
            m_shareGroup=std::make_shared<ShareGroup>();
            gles->setShareGroup(m_shareGroup);
            manager->groups[m_native.get()]=m_shareGroup;
        }
    }
    ~EglContext();
    unsigned getHndl() const { return m_hndl; }
    GLESVersion version() const { return m_version; }
    EglOS::Context* nativeType() const { return m_native.get(); }
    const SurfacePtr& read() const { return m_read; }
    const SurfacePtr& draw() const { return m_draw; }
    const ShareGroupPtr& getShareGroup() const { return m_shareGroup; }
    EglDisplay* m_dpy;
    std::shared_ptr<EglOS::Context> m_native;
    EglConfig* m_config;
    GLEScontext* m_glesContext;
    ShareGroupPtr m_shareGroup;
    SurfacePtr m_read,m_draw;
    GLESVersion m_version;
    ObjectNameManager* m_mngr;
    unsigned m_hndl=1;
};
ContextPtr EglDisplay::getContext(EGLContext ctx) { return caller && ctx==reinterpret_cast<EGLContext>(static_cast<uintptr_t>(caller->getHndl()))?caller:nullptr; }
static uintptr_t SafePointerFromUInt(unsigned value) { return value; }
static unsigned factoryCreates=0,factoryDeletes=0;
struct GLESiface {
    GLEScontext* createGLESContext(int,int,GlobalNameSpace*,gfxstream::Stream*) const { ++factoryCreates; return new GLESv2Context(); }
    void setShareGroup(GLEScontext* context,ShareGroupPtr group) const {
        CHECK(!deletedGlesOwners.count(context));
        context->setShareGroup(std::move(group));
    }
    void deleteGLESContext(GLEScontext* context) const {
        CHECK(deletedGlesOwners.insert(context).second);
        ++factoryDeletes;delete context;
    }
};
struct GlobalInfo { GLESiface iface; const GLESiface* getIface(GLESVersion) { return &iface; } };
static GlobalInfo info;
static GlobalInfo* g_eglInfo=&info;
static std::mutex driverLock;
static std::mutex* graphicsDriverLock() { return &driverLock; }
struct EglValidate { static bool noAttribs(const EGLint* attrs) { return !attrs || *attrs==EGL_NONE; } };
#define VALIDATE_DISPLAY_RETURN(display,result) auto* dpy=static_cast<EglDisplay*>(display); if(!dpy)return result
#define RETURN_ERROR(result,error) return result
@EGL_DTOR@
@EGL_FACTORY@

struct Scenario {
    EglDisplay display;
    EglContext* target;
    EglContext* caller;
    explicit Scenario(bool cm=false) {
        CHECK(CpuOwner::alive==0);
        currentNative=2;expectedNative=1;glCalls=foreignGlCalls=nativeDeletes=0;
        target=new EglContext(&display,0,&display.config,cm?static_cast<GLEScontext*>(new GLEScmContext()):new GLESv2Context(),GLES_2_0,0,&display.manager,nullptr);
        caller=new EglContext(&display,0,&display.config,new GLESv2Context(),GLES_2_0,0,&display.manager,nullptr);
        caller->m_hndl=2;
        display.caller=ContextPtr(caller,[](EglContext*){});
        s_threadInfo.eglContext=display.caller;
    }
    void finish() {
        display.native.failBind=display.native.failRestore=false;
        currentNative=2;expectedNative=2;
        delete caller;
        display.caller.reset();s_threadInfo.eglContext.reset();
        CHECK(CpuOwner::alive==0);
    }
};
int main() {
    EGLiface interface{};
#ifdef HAS_CPU_ONLY_SCOPE
    interface.isNativeGlCleanupAllowed=isNativeGlCleanupAllowed;
#endif
    s_eglIface=&interface;
    {
        Scenario s;
        delete s.target;
        CHECK(glCalls>20 && foreignGlCalls==0 && currentNative==2);
        CHECK(s.display.native.createCalls==1 && s.display.native.bindCalls==2 && nativeDeletes==1);
        s.finish();
        std::puts("PASS EGL noncurrent context binds for GL cleanup and restores its caller");
    }
    {
        Scenario s;s.display.native.failBind=true;
        int callerOwners=CpuOwner::alive/2;
        delete s.target;
        CHECK(glCalls==0 && foreignGlCalls==0 && currentNative==2);
        CHECK(CpuOwner::alive==callerOwners && nativeDeletes==1);
        s.finish();
        std::puts("PASS failed native bind frees all dying-context CPU owners without foreign-context GL");
    }
    {
        Scenario s;s.display.native.failPbuffer=true;
        delete s.target;
        CHECK(glCalls==0 && foreignGlCalls==0 && currentNative==2);
        CHECK(s.display.native.bindCalls==0);
        s.finish();
        std::puts("PASS failed teardown pbuffer creation frees CPU owners without asserting or rebinding");
    }
    {
        Scenario s(true);s.display.native.failBind=true;s.display.native.clearFailedBind=true;
        delete s.target;
        CHECK(glCalls==0 && foreignGlCalls==0 && currentNative==2);
        s.finish();
        std::puts("PASS GLES 1 core-profile and FBO cleanup also honor a failed bind that clears current state");
    }
    {
        Scenario s(true);
        delete s.target;
        CHECK(glCalls>40 && foreignGlCalls==0 && currentNative==2);
        s.finish();
        std::puts("PASS healthy GLES 1 core-profile cleanup still destroys native owners");
    }
    {
        Scenario s;s.display.native.failBind=true;
        auto fb=static_cast<FramebufferData*>(s.target->m_glesContext->m_fboNameSpace->data[0].get());
        auto rb=std::static_pointer_cast<RenderbufferData>(fb->m_attachPoints[1].obj);
        delete s.target;
        CHECK(glCalls==0 && rb->attachedFB==0 && rb->attachedPoint==0);
        rb.reset();s.finish();
        std::puts("PASS CPU-only FBO teardown detaches CPU bookkeeping while suppressing owned-attachment GL");
    }
    {
        Scenario s;
        s_threadInfo.eglContext=ContextPtr(s.target,[](EglContext*){});currentNative=1;
        delete s.target;s_threadInfo.eglContext= s.display.caller;
        CHECK(glCalls>20 && foreignGlCalls==0 && currentNative==0);
        CHECK(s.display.native.createCalls==0 && s.display.native.bindCalls==1);
        s.finish();
        std::puts("PASS already-current context cleans up without allocating a teardown pbuffer");
    }
    {
        Scenario s;s.display.native.failBind=true;s_threadInfo.eglContext.reset();currentNative=0;
        delete s.target;
        CHECK(glCalls==0 && currentNative==0 && s.display.native.bindCalls==2);
        s.finish();
        std::puts("PASS failed bind with no previous context leaves no GL context current");
    }
    {
        Scenario s;s.display.native.failRestore=true;
        delete s.target;
        CHECK(foreignGlCalls==0 && s.display.native.bindCalls==2);
        CHECK(std::any_of(logs.begin(),logs.end(),[](const auto& line){return line.find("Failed to restore native context after destroying EGL context")!=std::string::npos;}));
        s.finish();
        std::puts("PASS failed caller restoration is reported after cleanup without further GL work");
    }
    {
        Scenario s;s.display.native.failBind=true;
        auto sibling=s.target->m_shareGroup->texture;
        delete s.target;
        CHECK(glCalls==0 && sibling.use_count()==1);
        expectedNative=2;sibling.reset();
        CHECK(glCalls==1 && foreignGlCalls==0);
        s.finish();
        std::puts("PASS shared names retained by another owner are not poisoned by CPU-only cleanup");
    }
    {
        EglDisplay display;display.failNative=true;
        currentNative=expectedNative=2;glCalls=foreignGlCalls=0;
        const EGLint attrs[]={EGL_CONTEXT_MAJOR_VERSION_KHR,2,EGL_NONE};
        const auto before=factoryDeletes;
        CHECK(eglCreateOrLoadContext(&display,&display.config,EGL_NO_CONTEXT,attrs,nullptr)==EGL_NO_CONTEXT);
        CHECK(factoryDeletes==before+1 && CpuOwner::alive==0 && glCalls==0);
        CHECK(display.native.createCalls==0 && display.native.bindCalls==0 && currentNative==2);
        std::puts("PASS failed native context creation has one GLES owner and performs CPU-only cleanup");
        const auto created=factoryCreates;
        CHECK(eglCreateOrLoadContext(&display,&display.config,reinterpret_cast<EGLContext>(99),attrs,nullptr)==EGL_NO_CONTEXT);
        CHECK(factoryCreates==created && CpuOwner::alive==0);
        std::puts("PASS invalid sharing context is rejected before allocating a GLES owner");
    }
#ifdef HAS_CPU_ONLY_SCOPE
    {
        CHECK(isNativeGlCleanupAllowed());
        { ScopedNativeGlCleanup outer(false);
            CHECK(!GLEScontext::isNativeGlCleanupAllowed());
            {ScopedNativeGlCleanup inner(true);CHECK(!GLEScontext::isNativeGlCleanupAllowed());}
            CHECK(!GLEScontext::isNativeGlCleanupAllowed());
        }
        CHECK(GLEScontext::isNativeGlCleanupAllowed());
        std::puts("PASS nested cleanup scopes restore policy without enabling GL inside CPU-only cleanup");
    }
    {
        std::atomic<bool> cpuReady{false},gpuDone{false};
        std::thread cpu([&]{ScopedNativeGlCleanup cleanup(false);cpuReady=true;while(!gpuDone)std::this_thread::yield();CHECK(!GLEScontext::isNativeGlCleanupAllowed());});
        std::thread gpu([&]{
            while(!cpuReady)std::this_thread::yield();
            CHECK(GLEScontext::isNativeGlCleanupAllowed());
            currentNative=expectedNative=10;
            delete new GLESv2Context();
            CHECK(glCalls>20 && foreignGlCalls==0);
            gpuDone=true;
        });
        cpu.join();gpu.join();CHECK(GLEScontext::isNativeGlCleanupAllowed() && CpuOwner::alive==0);
        std::puts("PASS CPU-only cleanup policy is isolated to its thread through the EGL callback");
    }
    {
        s_eglIface=nullptr;CHECK(!GLEScontext::isNativeGlCleanupAllowed());s_eglIface=&interface;
        std::puts("PASS an uninitialized translator cannot issue native GL cleanup");
    }
    {
        currentNative=expectedNative=2;glCalls=foreignGlCalls=0;
        { ScopedNativeGlCleanup cleanup(false);
            for (int type=1;type<static_cast<int>(NamedObjectType::NUM_OBJECT_TYPES);++type)
                delete new NamedObject(static_cast<NamedObjectType>(type));
        }
        CHECK(glCalls==0 && CpuOwner::alive==0);
        for (int type=1;type<static_cast<int>(NamedObjectType::NUM_OBJECT_TYPES);++type)
            delete new NamedObject(static_cast<NamedObjectType>(type));
        CHECK(glCalls>=9 && foreignGlCalls==0 && CpuOwner::alive==0);
        std::puts("PASS every named-object type skips GL in CPU-only mode and retains normal deletion afterward");
    }
#endif
    ReadbackDiagnostics::get().log();
#ifdef HAS_CPU_ONLY_SCOPE
    CHECK(std::any_of(logs.begin(),logs.end(),[](const auto& line){return line.find("eglContextCpuOnly=7")!=std::string::npos;}));
    CHECK(std::any_of(logs.begin(),logs.end(),[](const auto& line){return line.find("eglContextRestoreFailures=1")!=std::string::npos;}));
    std::puts("PASS EGL teardown diagnostics count CPU-only cleanup and caller restoration failures");
#endif
}
