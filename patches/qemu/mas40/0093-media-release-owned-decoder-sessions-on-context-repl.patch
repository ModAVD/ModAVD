+    uint64_t mId = 0;
+    std::unordered_map<uint64_t, MediaH264DecoderPlugin*> mDecoders;
+    uint64_t readId(void* ptr);  // read id from the address
+    void removeDecoder(uint64_t id);
+    uint64_t createId();
+    void addDecoder(uint64_t key,
