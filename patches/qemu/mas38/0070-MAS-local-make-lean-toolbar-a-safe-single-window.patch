From bace51c2016c8387e3a897ebf6f68cb0c489485e Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Sun, 1 Nov 2026 12:48:07 +0100
Subject: [PATCH 70/95] MAS local: make lean toolbar a safe single window

Use the guest power control property for lean-toolbar shutdown, keep the bounded sync and forced-exit fallback, and let completed main-loop closes pass through without a second confirmation. Embed the lean navigation controls in the framed emulator window so the native title bar owns minimize and close.

Change-Id: I9f4e2a7c6b8d0f1e3a5c7b9d2e4f6a8c0b1d3e5f
---
 .../android/skin/qt/emulator-container.cpp    |  7 ++-
 .../src/android/skin/qt/emulator-container.h  |  2 +
 .../android/skin/qt/emulator-qt-window.cpp    | 27 ++++++---
 .../src/android/skin/qt/tool-window.cpp       | 56 +++++++++++++------
 .../src/android/skin/qt/tool-window.h         |  6 +-
 5 files changed, 72 insertions(+), 26 deletions(-)

diff --git a/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.cpp b/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.cpp
index 740c6cd80..06678581f 100644
--- a/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.cpp
+++ b/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.cpp
@@ -17,6 +17,7 @@
 #include <qnamespace.h>   // for WindowMinimized
 #include <qwindowdefs.h>  // for WId
 #include <QFlags>         // for QFlags
+#include <QByteArray>      // for qgetenv
 #include <QFrame>         // for QFrame
 #include <QMoveEvent>     // for QMoveEvent
 #include <QObject>        // for QObject
@@ -76,7 +77,11 @@ EmulatorContainer::EmulatorContainer(EmulatorQtWindow* window)
 #ifdef __APPLE__
     setWindowFlags(Qt::WindowTitleHint | Qt::Window);
 #else
-    setWindowFlags(Qt::WindowTitleHint | Qt::Window | Qt::CustomizeWindowHint);
+    const bool lean = qgetenv("ANDROID_EMU_FULL_TOOLBAR") != "1";
+    setWindowFlags(Qt::WindowTitleHint | Qt::Window | Qt::CustomizeWindowHint |
+                   (lean ? (Qt::WindowMinimizeButtonHint |
+                            Qt::WindowCloseButtonHint)
+                         : Qt::WindowFlags()));
 #endif
 
 #ifdef __APPLE__
diff --git a/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.h b/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/emulator-container.h
