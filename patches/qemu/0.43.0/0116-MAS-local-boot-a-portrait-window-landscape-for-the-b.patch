diff --git a/android/android-ui/modules/aemu-ui-window/include/android/magic-skin-orientation.h b/android/android-ui/modules/aemu-ui-window/include/android/magic-skin-orientation.h
index cf00391f1..ae7f9e2fa 100644
--- a/android/android-ui/modules/aemu-ui-window/include/android/magic-skin-orientation.h
+++ b/android/android-ui/modules/aemu-ui-window/include/android/magic-skin-orientation.h
@@ -19,18 +19,25 @@
 // (b/307180733) sets hw.initialOrientation to the magic skin's own shape, so
 // that `-skin 1080x1920` on a landscape AVD starts upright. An AVD without
 // skin.name gets a magic skin made from its own hw.lcd.width / height
-// (avdInfo), and then that override threw away the orientation config.ini
+// (avdInfo), and then that override throws away the orientation config.ini
 // asks for: ModAVD keeps a 1280x720 or 1920x1080 screen and sets
-// hw.initialOrientation=portrait for a portrait instance (ModAVD#225), which
-// started landscape anyway.
+// hw.initialOrientation=portrait for a portrait instance (ModAVD#225).
 //
-// Whether the magic skin overrides hw.initialOrientation: not when it is the
-// AVD's own screen and config.ini gives an orientation.
-static inline bool magic_skin_overrides_orientation(int skinWidth,
-                                                    int skinHeight,
-                                                    int lcdWidth,
-                                                    int lcdHeight,
-                                                    bool orientationGiven) {
+// The window still boots in the skin's shape: Android draws its boot
+// animation in the screen's own shape (SurfaceFlinger's install orientation,
+// whatever the display rotation), so it is upright only there. The
+// orientation config.ini asked for is kept aside, and the lean window turns to
+// it once the boot animation is over.
+//
+// Whether to keep it: when the magic skin is the AVD's own screen and
+// config.ini gives an orientation. A -skin of another shape replaces it, as
+// upstream.
+static inline bool magic_skin_keeps_configured_orientation(
+        int skinWidth,
+        int skinHeight,
+        int lcdWidth,
+        int lcdHeight,
+        bool orientationGiven) {
     const bool ownScreen = skinWidth == lcdWidth && skinHeight == lcdHeight;
-    return !(ownScreen && orientationGiven);
+    return ownScreen && orientationGiven;
 }
