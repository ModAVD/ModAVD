@@ -106,15 +106,17 @@ std::vector<std::string> resetUserRotationWords(int lastSet, int initial) {
 }
 
 // One argument, the whole guest script: adb shell hands it to the guest's sh
-// as it is. `settings` fails until the settings service is up; the boot is
-// over at sys.boot_completed=1 (an empty getprop makes the test fail too).
+// as it is. `settings` fails until the settings service is up. The boot
+// animation is over when init has stopped it, or, without one, at
+// sys.boot_completed=1 (an empty getprop makes the tests fail too).
 std::vector<std::string> bootUserRotationArgs(int userRotation) {
     const std::string value = std::to_string(((userRotation % 4) + 4) % 4);
     return {"wait-for-device", "shell",
             "i=0; until settings put system user_rotation " + value +
                     " >/dev/null 2>&1; do i=$((i+1)); [ $i -lt 240 ] || "
                     "exit 1; sleep 0.25; done; until [ "
-                    "x$(getprop sys.boot_completed) = x1 ]; do sleep 0.5; "
+                    "x$(getprop init.svc.bootanim) = xstopped ] || [ "
+                    "x$(getprop sys.boot_completed) = x1 ]; do sleep 0.2; "
                     "done"};
 }
 }  // namespace lean_title_bar
