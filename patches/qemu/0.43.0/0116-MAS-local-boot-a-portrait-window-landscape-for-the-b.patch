+        // The boot animation is over and Android is at the start's display
+        // rotation: the window, booted in the screen's own shape, turns to
+        // the start too (nothing to do for a landscape instance).
+        if (mInitialRotation && mRotateWindow) {
+            mRotateWindow(mInitialRotation());
+        }
         mReady = true;
         mTitleBar->setRotateAvailable(true, QString());
         return;
