@@ -753,8 +754,21 @@ EmulatorQtWindow::EmulatorQtWindow(QWidget* parent)
                                : SKIN_ROTATION_90;
     }
     // The rotate button turns between this and the other orientation
-    // (ModAVD#225).
+    // (ModAVD#225). The AVD's own magic skin boots in the screen's shape,
+    // upright for the boot animation, and keeps the orientation config.ini
+    // asked for aside: that one is the start, which the lean window turns to
+    // once the boot animation is over.
     mInitialOrientation = mOrientation;
+    if (const char* configured = skin_configured_initial_orientation()) {
+        const bool landscape = !strcasecmp(configured, "landscape");
+        if (EmulatorSkin::getInstance()->isPortrait()) {
+            mInitialOrientation =
+                    landscape ? SKIN_ROTATION_270 : SKIN_ROTATION_0;
+        } else {
+            mInitialOrientation =
+                    landscape ? SKIN_ROTATION_0 : SKIN_ROTATION_90;
+        }
+    }
 
     android::base::ThreadLooper::setLooper(mLooper, true);
 
