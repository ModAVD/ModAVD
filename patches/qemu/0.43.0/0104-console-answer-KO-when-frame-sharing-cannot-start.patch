From 9cc4b6b8883644515308126eabda2a72189e96b3 Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Sat, 14 Nov 2026 20:12:30 +0100
Subject: [PATCH 104/116] console: answer KO when frame sharing cannot start

'screenrecord webrtc start' returned -1 without writing anything when the
shared memory could not be set up, and the console only writes OK for a
0 return. Clients waiting for OK / KO then sat until their own timeout
(10 s for the ModAVD manager). Reply with a KO line instead.

Refs ModAVD/ModAVD#210

Change-Id: I4a74713bd1177593c5429e650b8d9515d6f6e345
---
 android/android-emu/android/console.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/android/android-emu/android/console.cpp b/android/android-emu/android/console.cpp
index bb095cdbd..cbd1c6cf1 100644
--- a/android/android-emu/android/console.cpp
+++ b/android/android-emu/android/console.cpp
@@ -4074,8 +4074,13 @@ static int do_screenrecord_webrtc(ControlClient client, char* args) {
         if (name) {
             control_write(client, name);
             control_write(client, "\r\n");
+            return 0;
         }
-        return name ? 0 : -1;
+        // Without a reply line the client waits for OK / KO until it times
+        // out; say why instead.
+        control_write(client,
+                      "KO: unable to share frames (see the emulator log)\r\n");
+        return -1;
 
     } else if (splitArgs[0] == "stop") {
         return client->global->record_agent->stopSharedMemoryModule() ? 0 : -1;
