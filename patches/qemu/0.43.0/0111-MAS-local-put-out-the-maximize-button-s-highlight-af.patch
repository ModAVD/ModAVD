diff --git a/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/windows-lean-frame.cpp b/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/windows-lean-frame.cpp
index b66750385..0fb10d125 100644
--- a/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/windows-lean-frame.cpp
+++ b/android/android-ui/modules/aemu-ui-qt/src/android/skin/qt/windows-lean-frame.cpp
@@ -218,6 +218,21 @@ void WindowsLeanFrame::reportMaxButton(const lw::MaxButtonTracker& before,
     }
 }
 
+void WindowsLeanFrame::watchForLeave(WId wid) {
+    if (!lw::needsLeaveNotice(mMaxButtonTracker)) {
+        return;
+    }
+    // WM_NCMOUSELEAVE once the mouse leaves the non-client part, onto the
+    // other buttons, the guest screen or another window. Asked for whenever
+    // the button lights up, not only on WM_NCMOUSEMOVE: a press or a release
+    // over it can come first (ModAVD#214), and the highlight would stay.
+    TRACKMOUSEEVENT track = {};
+    track.cbSize = sizeof(track);
+    track.dwFlags = TME_LEAVE | TME_NONCLIENT;
+    track.hwndTrack = reinterpret_cast<HWND>(wid);
+    TrackMouseEvent(&track);
+}
+
 bool WindowsLeanFrame::handleMessage(void* message, qintptr* result) {
     MSG* msg = static_cast<MSG*>(message);
     HWND hwnd = msg->hwnd;
