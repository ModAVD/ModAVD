diff --git a/android/android-ui/modules/aemu-ui-window/include/android/lean-window-frame.h b/android/android-ui/modules/aemu-ui-window/include/android/lean-window-frame.h
index 6479aebca..0f3239ceb 100644
--- a/android/android-ui/modules/aemu-ui-window/include/android/lean-window-frame.h
+++ b/android/android-ui/modules/aemu-ui-window/include/android/lean-window-frame.h
@@ -114,6 +114,13 @@ struct MaxButtonTracker {
     void leave();
 };
 
+// Whether the window has to ask for WM_NCMOUSELEAVE (TrackMouseEvent with
+// TME_LEAVE | TME_NONCLIENT) after a message: whenever the button is lit,
+// whichever message lit it. A press or a release over the button can come
+// without a WM_NCMOUSEMOVE before it, and without the request no leave
+// message comes to put the highlight out (ModAVD#214).
+bool needsLeaveNotice(const MaxButtonTracker& tracker);
+
 // Whether |hit| resizes the window.
 bool isResize(Hit hit);
 
diff --git a/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp b/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp
index c16a0aaa3..80144ff89 100644
--- a/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp
+++ b/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp
@@ -103,6 +103,10 @@ void MaxButtonTracker::leave() {
     down = false;
 }
 
+bool needsLeaveNotice(const MaxButtonTracker& tracker) {
+    return tracker.hot || tracker.down;
+}
+
 bool isResize(Hit hit) {
     return static_cast<int>(hit) >= static_cast<int>(Hit::Left) &&
            static_cast<int>(hit) <= static_cast<int>(Hit::BottomRight);
diff --git a/android/android-ui/modules/aemu-ui-window/test/android/lean-window-frame_unittest.cpp b/android/android-ui/modules/aemu-ui-window/test/android/lean-window-frame_unittest.cpp
index e585f6810..d75609e3e 100644
--- a/android/android-ui/modules/aemu-ui-window/test/android/lean-window-frame_unittest.cpp
+++ b/android/android-ui/modules/aemu-ui-window/test/android/lean-window-frame_unittest.cpp
@@ -432,6 +432,35 @@ TEST(LeanWindowFrame, MaxButtonTrackerPressLeavesTheButton) {
     EXPECT_FALSE(t.down);
 }
 
+TEST(LeanWindowFrame, MaxButtonTrackerLitWithoutMoveWantsLeave) {
+    // ModAVD#214: a press or a release over the button with no
+    // WM_NCMOUSEMOVE before it lights the button too, and the window has to
+    // ask for WM_NCMOUSELEAVE then as well, or the highlight stays.
+    lw::MaxButtonTracker t;
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+    EXPECT_FALSE(t.release(Hit::MaxButton));
+    EXPECT_TRUE(t.hot);
+    EXPECT_TRUE(lw::needsLeaveNotice(t));
+    t.leave();
+    EXPECT_FALSE(t.hot);
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+
+    t.press(Hit::MaxButton);
+    EXPECT_TRUE(lw::needsLeaveNotice(t));
+    t.leave();
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+
+    t.move(Hit::MaxButton);
+    EXPECT_TRUE(lw::needsLeaveNotice(t));
+    // Off the button onto the title bar: nothing lit, nothing to watch.
+    t.move(Hit::Caption);
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+    t.press(Hit::Caption);
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+    EXPECT_FALSE(t.release(Hit::Caption));
+    EXPECT_FALSE(lw::needsLeaveNotice(t));
+}
+
