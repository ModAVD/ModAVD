+#include "android/skin/qt/lean-rotate.h"
+
+#include <QPushButton>
+#include <QString>
+
+#include <string>
+#include <utility>
+
+#include "android/base/system/System.h"
+#include "android/emulation/control/adb/AdbInterface.h"
+#include "android/lean-title-bar-logic.h"
+#include "android/skin/qt/lean-title-bar.h"
+
+namespace tb = android::lean_title_bar;
+using android::emulation::AdbInterface;
+using android::emulation::OptionalAdbCommandResult;
+
+namespace {
+
+constexpr int kAdbTimeoutMs = 5000;
+
+}  // namespace
+
+LeanRotateControl::LeanRotateControl(LeanTitleBar* titleBar,
+                                     AdbGetter adb,
+                                     WindowRotator rotateWindow)
+    : QObject(titleBar),
+      mTitleBar(titleBar),
+      mAdb(std::move(adb)),
+      mRotateWindow(std::move(rotateWindow)) {
+    connect(mTitleBar->rotateButton(), &QPushButton::clicked, this,
+            &LeanRotateControl::rotate);
+
+    const std::string port =
+            android::base::System::get()->envGet("ANDROID_ADB_SERVER_PORT");
+    if (!tb::adbServerPortUsable(port.empty() ? nullptr : port.c_str())) {
+        mTitleBar->setRotateAvailable(
+                false, QString::fromUtf8("旋转屏幕：没有可用的 adb 服务，转不了"));
+    }
+}
+
+void LeanRotateControl::checkAvailable() {
+    if (!mTitleBar->rotateAvailable()) {
+        return;
+    }
+    AdbInterface* adb = mAdb ? mAdb() : nullptr;
+    if (!adb || adb->detectedAdbPath().empty()) {
+        mTitleBar->setRotateAvailable(
+                false, QString::fromUtf8("旋转屏幕：没找到 adb，转不了"));
+    }
+}
+
+void LeanRotateControl::rotate() {
+    AdbInterface* adb = mAdb ? mAdb() : nullptr;
+    if (!adb || !mRotateWindow) {
+        return;
+    }
+    const int to = mRotateWindow();
+    if (to < 0) {
+        return;
+    }
+    // The picture turns with the window: the guest draws it at the user
+    // rotation, the only one it follows.
+    adb->runAdbCommand(tb::setUserRotationArgs(tb::guestUserRotation(to)),
+                       [](const OptionalAdbCommandResult&) {}, kAdbTimeoutMs,
+                       false);
+}
