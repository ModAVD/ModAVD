+int ToolWindow::rotateLeanWindow() {
+    if (!sUiEmuAgent || !sUiEmuAgent->window || !sUiEmuAgent->sensors) {
+        return -1;
+    }
+    const int from = sUiEmuAgent->window->getRotation();
+    const auto to = static_cast<SkinRotation>(
+            android::lean_title_bar::rotateButtonTarget(from));
+    // The window keeps its centre and stays on the screen once it has turned.
+    mEmulatorWindow->prepareLeanRotation();
+    // The way ROTATE_LEFT / ROTATE_RIGHT turn it: the device's orientation,
+    // which the virtual sensors page passes on to the window (rotateSkin).
+    sUiEmuAgent->sensors->setCoarseOrientation(
+            skin_rotation_to_coarse_orientation(to));
+    skin_winsys_touch_qt_extended_virtual_sensors();
+    return to;
+}
