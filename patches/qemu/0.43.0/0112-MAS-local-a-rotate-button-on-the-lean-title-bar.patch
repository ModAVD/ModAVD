+void EmulatorQtWindow::prepareLeanRotation() {
+    mLeanRotation = LeanRotation();
+    if (!ToolWindow::inWindowNav() || mInZoomMode) {
+        return;
+    }
+    mLeanRotation.pending = true;
+    mLeanRotation.frameBefore = mContainer.frameGeometry();
+    mLeanRotation.wideBefore = width() > height();
+}
+
+void EmulatorQtWindow::placeAfterLeanRotation(const QSize& guest) {
+    if (!mLeanRotation.pending ||
+        (guest.width() > guest.height()) == mLeanRotation.wideBefore) {
+        // Not the rotate button's turn, or the guest screen has not turned
+        // yet.
+        return;
+    }
+    namespace lw = android::lean_window;
+    const auto toRect = [](const QRect& r) {
+        return lw::Rect{r.left(), r.top(), r.left() + r.width(),
+                        r.top() + r.height()};
+    };
+    const QRect before = mLeanRotation.frameBefore;
+    QScreen* screen = QGuiApplication::screenAt(before.center());
+    if (!screen) {
+        screen = mContainer.screen();
+    }
+    if (!screen) {
+        mLeanRotation.pending = false;
+        return;
+    }
+    const lw::Rect work = toRect(screen->availableGeometry());
+    // Around the guest screen: the title bar, and whatever frame the system
+    // keeps around the window.
+    const QSize margins =
+            mContainer.frameGeometry().size() - mContainer.geometry().size();
+    const QSize around = ToolWindow::windowChrome() + margins;
+    const lw::Size fitted = lw::fitInto({guest.width(), guest.height()},
+                                        {around.width(), around.height()},
+                                        work);
+    if (!mLeanRotation.shrunk &&
+        (fitted.width < guest.width() || fitted.height < guest.height())) {
+        // Too large for the screen now that it is turned: scale it down to
+        // fit, which comes back here with the smaller guest screen.
+        mLeanRotation.shrunk = true;
+        const QSize smaller(fitted.width, fitted.height);
+        QTimer::singleShot(0, this, [this, smaller] {
+            if (!mInZoomMode) {
+                doResize(smaller);
+            }
+        });
+        return;
+    }
+    mLeanRotation.pending = false;
+    const QSize frame = guest + around;
+    const lw::Rect placed = lw::placeKeepingCenter(
+            toRect(before), frame.width(), frame.height(), work);
+    mContainer.move(placed.left, placed.top);
+}
