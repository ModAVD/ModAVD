index 80144ff89..e568ebe34 100644
--- a/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp
+++ b/android/android-ui/modules/aemu-ui-window/src/android/lean-window-frame.cpp
@@ -175,5 +175,43 @@ Rect visiblePart(const Rect& window, const Rect& work) {
     return r.width() > 0 && r.height() > 0 ? r : window;
 }
 
+Size fitInto(const Size& guest, const Size& chrome, const Rect& work) {
+    const long long gw = std::max(1, guest.width);
+    const long long gh = std::max(1, guest.height);
+    const long long roomW = std::max(1, work.width() - chrome.width);
+    const long long roomH = std::max(1, work.height() - chrome.height);
+    if (gw <= roomW && gh <= roomH) {
+        return {static_cast<int>(gw), static_cast<int>(gh)};
+    }
+    // The tighter of the two sides sets the scale: roomW / gw against
+    // roomH / gh, cross-multiplied.
+    long long w = 0;
+    long long h = 0;
+    if (roomW * gh <= roomH * gw) {
+        w = roomW;
+        h = gh * roomW / gw;
+    } else {
+        h = roomH;
+        w = gw * roomH / gh;
+    }
+    return {static_cast<int>(std::max(1LL, w)),
+            static_cast<int>(std::max(1LL, h))};
+}
+
+Rect placeKeepingCenter(const Rect& before, int width, int height,
+                        const Rect& work) {
+    // Half the difference, rounded down also when the window grows.
+    const auto start = [](int from, int oldLength, int newLength) {
+        const int diff = oldLength - newLength;
+        return from + (diff >= 0 ? diff / 2 : -((-diff + 1) / 2));
+    };
+    int left = start(before.left, before.width(), width);
+    int top = start(before.top, before.height(), height);
+    // Inside the work area; when it does not fit, its top-left is.
+    left = std::max(std::min(left, work.right - width), work.left);
+    top = std::max(std::min(top, work.bottom - height), work.top);
+    return {left, top, left + width, top + height};
+}
+
 }  // namespace lean_window
 }  // namespace android
