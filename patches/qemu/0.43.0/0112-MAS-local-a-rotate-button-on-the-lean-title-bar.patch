+
+class LeanTitleBar;
+
+namespace android {
+namespace emulation {
+class AdbInterface;
+}  // namespace emulation
+}  // namespace android
+
+// The rotate button's control (ModAVD#225): a click turns the window between
+// landscape and portrait the way the full toolbar's rotate does, and sets the
+// guest's display rotation to match over adb (`settings put system
+// user_rotation`), since the manager fixes the display to the user rotation
+// and the guest does not follow the sensors. adb runs on the AdbInterface's own
+// thread and talks only to the adb server that ANDROID_ADB_SERVER_PORT names,
+// as the volume button's: without one, or without adb, the button is disabled
+// and says why.
+class LeanRotateControl : public QObject {
+    Q_OBJECT
+
+public:
+    using AdbGetter = std::function<android::emulation::AdbInterface*()>;
+    // Turns the window and gives the SkinRotation it turns to, or -1 when it
+    // does not turn.
+    using WindowRotator = std::function<int()>;
+
+    LeanRotateControl(LeanTitleBar* titleBar,
+                      AdbGetter adb,
+                      WindowRotator rotateWindow);
+
+    // Disables the button when there is no adb or no adb server of the
+    // manager's to talk to; called once the window is up, as the volume
+    // control's.
+    void checkAvailable();
+
+private:
+    void rotate();
+
+    LeanTitleBar* mTitleBar;
+    AdbGetter mAdb;
+    WindowRotator mRotateWindow;
+};
