+// Android starts at the display rotation the button may have left in its
+// settings last time; the window starts at hw.initialOrientation. Make
+// Android's match the window's as early as it can be set, then wait for the
+// boot to finish.
+void LeanRotateControl::startBootSync() {
+    AdbInterface* adb = mAdb ? mAdb() : nullptr;
+    if (!adb || !mInitialRotation) {
+        return;
+    }
+    QPointer<LeanRotateControl> self(this);
+    auto command = adb->runAdbCommand(
+            tb::bootUserRotationArgs(tb::guestUserRotation(mInitialRotation())),
+            [self](const OptionalAdbCommandResult& result) {
+                const bool success = result && result->exit_code == 0;
+                postToUi(self, [success](LeanRotateControl& control) {
+                    control.bootSyncDone(success);
+                });
+            },
+            kBootSyncTimeoutMs, false);
+    if (!command) {
+        bootSyncDone(false);
+    }
+}
+
+void LeanRotateControl::bootSyncDone(bool success) {
+    if (success) {
+        mReady = true;
+        mTitleBar->setRotateAvailable(true, QString());
+        return;
     }
+    dwarning("Rotate button: the guest's display rotation is not set yet; "
+             "trying again");
+    QTimer::singleShot(kBootSyncRetryMs, this,
+                       &LeanRotateControl::startBootSync);
 }
 
 void LeanRotateControl::rotate() {
+    if (!mReady || mRotating || !mTarget || !mRotateWindow) {
+        return;
+    }
     AdbInterface* adb = mAdb ? mAdb() : nullptr;
-    if (!adb || !mRotateWindow) {
