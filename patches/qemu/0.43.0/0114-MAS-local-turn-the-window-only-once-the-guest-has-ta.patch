-    const int to = mRotateWindow();
+    const int to = mTarget();
     if (to < 0) {
         return;
     }
-    // A click during the boot wins over the boot's setting.
-    if (mBootSync && mBootSync->inFlight()) {
-        mBootSync->cancel();
+    // The guest first: the window turns once the guest has taken the new
+    // display rotation, so a guest that does not leaves both as they were.
+    mRotating = true;
+    QPointer<LeanRotateControl> self(this);
+    auto command = adb->runAdbCommand(
+            tb::setUserRotationArgs(tb::guestUserRotation(to)),
+            [self, to](const OptionalAdbCommandResult& result) {
+                const bool success = result && result->exit_code == 0;
+                postToUi(self, [to, success](LeanRotateControl& control) {
+                    control.guestRotated(to, success);
+                });
+            },
+            kAdbTimeoutMs, false);
+    if (!command) {
+        guestRotated(to, false);
+    }
+}
+
+void LeanRotateControl::guestRotated(int to, bool success) {
+    mRotating = false;
+    if (!success) {
+        dwarning("Rotate button: the guest did not take the display rotation; "
+                 "the window stays as it is");
+        return;
     }
-    mBootSync.reset();
-    // The picture turns with the window: the guest draws it at the user
-    // rotation, the only one it follows.
-    adb->runAdbCommand(tb::setUserRotationArgs(tb::guestUserRotation(to)),
-                       [](const OptionalAdbCommandResult&) {}, kAdbTimeoutMs,
-                       false);
+    mRotateWindow(to);
 }
