+TEST_F(SafeShutdownTest, RunsBeforeSyncWordsInTheFirstSync) {
+    // ModAVD#225: the rotate button's display rotation goes back first, in
+    // the same guest shell as the sync.
+    beforeSync = {"settings", "put", "system", "user_rotation", "0"};
+    auto shutdown = make();
+    shutdown->start();
