+              "0 >/dev/null 2>&1 && exit 0; i=$((i+1)); sleep 0.25; done; "
+              "exit 1");
+    EXPECT_NE(tb::bootUserRotationArgs(3)[2].find("user_rotation 3 "),
+              std::string::npos);
+    EXPECT_NE(tb::bootUserRotationArgs(-1)[2].find("user_rotation 3 "),
+              std::string::npos);
+    // A portrait start on a landscape skin boots at ROTATION_270.
+    EXPECT_NE(tb::bootUserRotationArgs(tb::guestUserRotation(1))[2].find(
+                      "user_rotation 3 "),
+              std::string::npos);
+}
