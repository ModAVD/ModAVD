+std::vector<std::string> resetUserRotationWords(int lastSet, int initial) {
+    const int wanted = guestUserRotation(initial);
+    if (lastSet < 0 || lastSet == wanted) {
+        return {};
+    }
+    std::vector<std::string> words = setUserRotationArgs(wanted);
+    words.erase(words.begin());  // "shell"
+    return words;
+}
+
+// One argument, the whole guest script: adb shell hands it to the guest's sh
+// as it is. `settings` fails until the settings service is up.
+std::vector<std::string> bootUserRotationArgs(int userRotation) {
+    const std::string value = std::to_string(((userRotation % 4) + 4) % 4);
+    return {"wait-for-device", "shell",
+            "i=0; while [ $i -lt 240 ]; do settings put system user_rotation " +
+                    value +
+                    " >/dev/null 2>&1 && exit 0; i=$((i+1)); sleep 0.25; "
+                    "done; exit 1"};
+}
+
