+// limitations under the License.
+#pragma once
+
+#include <stdbool.h>
+
+// A "magic" skin, "<width>x<height>", has no layout file. Upstream
+// (b/307180733) sets hw.initialOrientation to the magic skin's own shape, so
+// that `-skin 1080x1920` on a landscape AVD starts upright. An AVD without
+// skin.name gets a magic skin made from its own hw.lcd.width / height
+// (avdInfo), and then that override threw away the orientation config.ini
+// asks for: ModAVD keeps a 1280x720 or 1920x1080 screen and sets
+// hw.initialOrientation=portrait for a portrait instance (ModAVD#225), which
+// started landscape anyway.
+//
+// Whether the magic skin overrides hw.initialOrientation: not when it is the
+// AVD's own screen and config.ini gives an orientation.
+static inline bool magic_skin_overrides_orientation(int skinWidth,
+                                                    int skinHeight,
+                                                    int lcdWidth,
+                                                    int lcdHeight,
+                                                    bool orientationGiven) {
+    const bool ownScreen = skinWidth == lcdWidth && skinHeight == lcdHeight;
+    return !(ownScreen && orientationGiven);
+}
diff --git a/android/android-ui/modules/aemu-ui-window/src/android/skin/user-config.c b/android/android-ui/modules/aemu-ui-window/src/android/skin/user-config.c
index adbfe82ae..0607d42fa 100644
--- a/android/android-ui/modules/aemu-ui-window/src/android/skin/user-config.c
+++ b/android/android-ui/modules/aemu-ui-window/src/android/skin/user-config.c
@@ -23,6 +23,7 @@
 #include "android/cmdline-definitions.h"
 #include "android/console.h"
 #include "android/emulation/control/globals_agent.h"
+#include "android/magic-skin-orientation.h"
 #include "android/skin/charmap.h"
 #include "android/skin/rect.h"
 #include "android/skin/resource.h"
@@ -348,15 +349,24 @@ void parse_skin_files(const char* skinDirPath,
 
             // change initialOrientation to match magic skin
             // b/307180733
-
-            if (hwConfig->hw_initialOrientation) {
-                free(hwConfig->hw_initialOrientation);
-            }
-
-            if (width > height) {
-                hwConfig->hw_initialOrientation = strdup("landscape");
-            } else {
-                hwConfig->hw_initialOrientation = strdup("portrait");
+            // ... unless the magic skin is the AVD's own screen and
+            // config.ini gives an orientation (ModAVD#225).
+            const char* given = hwConfig->hw_initialOrientation;
+            const bool orientationGiven =
+                    given && (!strcasecmp(given, "portrait") ||
+                              !strcasecmp(given, "landscape"));
+            if (magic_skin_overrides_orientation(
+                        width, height, hwConfig->hw_lcd_width,
+                        hwConfig->hw_lcd_height, orientationGiven)) {
+                if (hwConfig->hw_initialOrientation) {
+                    free(hwConfig->hw_initialOrientation);
+                }
+
+                if (width > height) {
+                    hwConfig->hw_initialOrientation = strdup("landscape");
+                } else {
+                    hwConfig->hw_initialOrientation = strdup("portrait");
+                }
             }
             snprintf(tmp, sizeof tmp,
                      "display {\n  width %d\n  height %d\n bpp %d}\n", width,
diff --git a/android/android-ui/modules/aemu-ui-window/test/android/lean-title-bar-logic_unittest.cpp b/android/android-ui/modules/aemu-ui-window/test/android/lean-title-bar-logic_unittest.cpp
index a3ffce139..078116e2f 100644
--- a/android/android-ui/modules/aemu-ui-window/test/android/lean-title-bar-logic_unittest.cpp
+++ b/android/android-ui/modules/aemu-ui-window/test/android/lean-title-bar-logic_unittest.cpp
@@ -12,6 +12,7 @@
 // See the License for the specific language governing permissions and
 // limitations under the License.
 #include "android/lean-title-bar-logic.h"
+#include "android/magic-skin-orientation.h"
 
 #include <gtest/gtest.h>
 
@@ -158,3 +159,15 @@ TEST(LeanTitleBarLogic, BootUserRotationArgs) {
                       "user_rotation 3 "),
               std::string::npos);
 }
+
+TEST(LeanTitleBarLogic, MagicSkinOverridesOrientation) {
+    // No skin.name: the magic skin is the AVD's own screen, and config.ini's
+    // hw.initialOrientation stands (a portrait instance on 1280x720).
+    EXPECT_FALSE(magic_skin_overrides_orientation(1280, 720, 1280, 720, true));
+    EXPECT_FALSE(magic_skin_overrides_orientation(1920, 1080, 1920, 1080, true));
+    // Without an orientation it takes the skin's shape, as upstream.
+    EXPECT_TRUE(magic_skin_overrides_orientation(1280, 720, 1280, 720, false));
+    // -skin of another shape (b/307180733): the skin's shape wins.
+    EXPECT_TRUE(magic_skin_overrides_orientation(720, 1280, 1280, 720, true));
+    EXPECT_TRUE(magic_skin_overrides_orientation(1920, 1080, 1280, 720, true));
+}
