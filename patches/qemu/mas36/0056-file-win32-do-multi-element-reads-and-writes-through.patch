From 1b402346a10efa2dc9b1f2e2b7b46734ac4c5fad Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Wed, 21 Oct 2026 09:27:37 +0200
Subject: [PATCH 56/65] file-win32: do multi-element reads and writes through
 one bounce buffer

A guest request usually reaches the file driver with one iovec per guest
page, 256 of them for 1 MiB, and handle_aiocb_rw() issued one WriteFile()
or ReadFile() per element. Large transfers were about twice as slow as on
other Windows emulators: 1 MiB synchronous writes in the guest took
2.7-3.9 ms against 1.3-2.2 ms on MuMu, while 4-64 KiB writes were on par.

Copy requests with more than one element, up to 64 MiB, into a single
buffer and issue one call. Larger requests, or a failed allocation, keep
the per-element loop. Durability is unchanged: the data is handed to the
same file handle with the same flags before the request completes.

Change-Id: I0b92799255add52aa896a4ab0599396e1daf15d6
---
 block/file-win32.c | 43 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/block/file-win32.c b/block/file-win32.c
index 99b38721b..9edef330a 100644
--- a/block/file-win32.c
+++ b/block/file-win32.c
@@ -69,6 +69,40 @@ typedef struct BDRVRawState {
 #endif
 } BDRVRawState;
 
+/*
+ * MAS: a guest request usually arrives with one iovec per guest page (256 of
+ * them for 1 MiB), and one WriteFile/ReadFile per element made large
+ * transfers about twice as slow as on other Windows emulators. Requests with
+ * more than one element up to this size go through a single bounce buffer
+ * instead; larger ones, or when the buffer cannot be allocated, keep the
+ * per-element loop.
+ */
+#define RAW_WIN32_BOUNCE_MAX (64 * 1024 * 1024)
+
+static size_t handle_aiocb_rw_bounce(RawWin32AIOData *aiocb, void *buf)
+{
+    OVERLAPPED ov;
+    DWORD ret, ret_count = 0;
+    DWORD len = aiocb->aio_nbytes;
+
+    memset(&ov, 0, sizeof(ov));
+    ov.Offset = aiocb->aio_offset;
+    ov.OffsetHigh = aiocb->aio_offset >> 32;
+    if (aiocb->aio_type & QEMU_AIO_WRITE) {
+        iov_to_buf(aiocb->aio_iov, aiocb->aio_niov, 0, buf, len);
+        ret = WriteFile(aiocb->hfile, buf, len, &ret_count, &ov);
+    } else {
+        ret = ReadFile(aiocb->hfile, buf, len, &ret_count, &ov);
+    }
+    if (!ret) {
+        ret_count = 0;
+    }
+    if (!(aiocb->aio_type & QEMU_AIO_WRITE) && ret_count) {
+        iov_from_buf(aiocb->aio_iov, aiocb->aio_niov, 0, buf, ret_count);
+    }
+    return ret_count;
+}
+
 /*
  * Read/writes the data to/from a given linear buffer.
  *
@@ -80,6 +114,15 @@ static size_t handle_aiocb_rw(RawWin32AIOData *aiocb)
     size_t offset = 0;
     int i;
 
+    if (aiocb->aio_niov > 1 && aiocb->aio_nbytes <= RAW_WIN32_BOUNCE_MAX) {
+        void *buf = g_try_malloc(aiocb->aio_nbytes);
+        if (buf) {
+            offset = handle_aiocb_rw_bounce(aiocb, buf);
+            g_free(buf);
+            return offset;
+        }
+    }
+
     for (i = 0; i < aiocb->aio_niov; i++) {
         OVERLAPPED ov;
         DWORD ret, ret_count, len;
