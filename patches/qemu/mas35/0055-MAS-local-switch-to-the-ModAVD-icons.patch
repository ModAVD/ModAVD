From 5aedc70819651ef386cef810afa6c2be3c028467 Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Sat, 17 Oct 2026 15:45:06 +0200
Subject: [PATCH 55/60] MAS local: switch to the ModAVD icons

Replace the emulator icons with the ModAVD icon: emulator_icon.ico (the
program icon of emulator.exe and emulator-check.exe) and the 32, 128 and
256 px PNGs compiled into android/icons.h (window and taskbar icon, crash
report dialog). The .ico has 16 to 256 px entries; up to 24 px they use
a simplified drawing.

Also give qemu-system-x86_64.exe and qemu-system-x86_64-headless.exe the
program icon; they had no icon resource.

Change-Id: I8d12b7dfc8c64a0915ae58bb1bd8bd17dd0ae01a
---
 CMakeLists.txt                                |    7 +
 .../aemu-ui-window/include/android/icons.h    | 4767 +++++++++++++----
 android/images/emulator_icon.ico              |  Bin 54023 -> 70443 bytes
 android/images/emulator_icon_128.png          |  Bin 3761 -> 13427 bytes
 android/images/emulator_icon_256.png          |  Bin 7534 -> 28925 bytes
 android/images/emulator_icon_32.png           |  Bin 1265 -> 2386 bytes
 6 files changed, 3731 insertions(+), 1043 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bd1f0098b..8adf8728c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1015,6 +1015,13 @@ if(NOT OPTION_AEMU_LIBS_ONLY)
       x86_64 "${ANDROID_QEMU_i386_DEVICES_${ANDROID_TARGET_TAG}}")
     android_add_qemu_headless_executable(
       x86_64 "${ANDROID_QEMU_i386_DEVICES_${ANDROID_TARGET_TAG}}")
+    # MAS local: the x86_64 binaries carry the program icon as well.
+    if(WIN32)
+      add_resource(TARGET qemu-system-x86_64
+                   RESOURCE android/images/emulator_icon.rc)
+      target_sources(qemu-system-x86_64-headless
+                     PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/emulator_icon.res)
+    endif()
   endif()
   android_add_qemu_executable(
     aarch64 "${ANDROID_QEMU_arm_DEVICES_${ANDROID_TARGET_TAG}}")
