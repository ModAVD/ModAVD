@@ -27,6 +27,9 @@ enum class Hit : int {
     Nowhere = 0,
     Client = 1,
     Caption = 2,
+    // The title bar's maximize / restore button (ModAVD#185): Windows 11
+    // shows its snap layouts over it.
+    MaxButton = 9,
