+// static
+void WindowsLeanFrame::toggleMaximized(WId wid) {
+    HWND hwnd = reinterpret_cast<HWND>(wid);
+    if (!hwnd || IsIconic(hwnd)) {
+        return;
+    }
+    // Posted, like the system menu's commands: the button's click is still
