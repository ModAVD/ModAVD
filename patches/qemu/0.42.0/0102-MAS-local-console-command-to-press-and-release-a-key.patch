From 431eae373d85f12b9edd3d7f81988c55083c9bbe Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Sat, 14 Nov 2026 04:01:02 +0100
Subject: [PATCH 102/110] MAS local: console command to press and release a
 keyboard key

'event key <code> <0|1>' presses or releases a key of the emulator's keyboard by its Linux input code, the way the toolbar buttons do (user_event_agent->sendKey). The console had no way to send BACK, HOME or APP_SWITCH: 'event send' delivers EV_KEY to the multi-touch device, whose key bitmap has none of them, so the guest drops it, and 'event text' only types characters. ModAVDExtras uses it for modavd_key(); without arguments the command answers with its usage, which is how a client tells it is there.

Test: built incrementally on Windows; on a 0.40.2 root with the new qemu-system-x86_64, 158 went back, 102 went home, 580 opened the overview, 1 went back, 14 and 28 edited a text field.
Change-Id: I266da1206481516fb92a274cab525715bcfe64ad
---
 android/android-emu/android/console.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/android/android-emu/android/console.cpp b/android/android-emu/android/console.cpp
index 465f8d0fa..bb095cdbd 100644
--- a/android/android-emu/android/console.cpp
+++ b/android/android-emu/android/console.cpp
@@ -2476,7 +2476,32 @@ static int do_event_text(ControlClient client, char* args) {
     return 0;
 }
 
+// 'event key <code> <0|1>': presses or releases a key of the emulator's
+// keyboard, like the toolbar buttons do. <code> is a Linux input key code
+// (KEY_*: 158 is BACK, 172 the home page key). 'event send' cannot do this: it
+// sends to the touch screen, which has no such keys, and 'event text' only
+// types characters.
+static int do_event_key(ControlClient client, char* args) {
+    int code = 0, down = 0, len = 0;
+    if (!args || sscanf(args, "%d %d%n", &code, &down, &len) != 2 ||
+        len != (int)strlen(args) || code <= 0 || code > 0x3ff ||
+        (down != 0 && down != 1)) {
+        control_write(client, "KO: usage: event key <code> <0|1>\r\n");
+        return -1;
+    }
+    client->global->user_event_agent->sendKey(code, down == 1);
+    return 0;
+}
+
 static const CommandDefRec event_commands[] = {
+        {"key", "press or release a key",
+         "'event key <code> <0|1>' presses (1) or releases (0) a key of the "
+         "keyboard.\r\n"
+         "<code> is a Linux input key code from 1 to 1023, e.g. 158 for BACK, "
+         "172 for\r\n"
+         "the home page key or 28 for ENTER\r\n",
+         NULL, do_event_key, NULL},
+
         {"send", "send a series of events to the kernel",
          "'event send <type>:<code>:<value> ...' allows you to send one or "
          "more hardware events\r\n"
