+    const auto actualQueueProperties = helper.getQueueFamilyProperties();
+    EXPECT_THAT(actualQueueProperties.size(), 3);
+    EXPECT_THAT(actualQueueProperties[0], EqsVkQueueFamilyProperties(expectedQueueFamilyProperties[0]));
