+         .queueCount = 16,
+         .timestampValidBits = 64,
+         .minImageTransferGranularity = {1, 1, 1}},
+        // NOTE: VK_QUEUE_TRANSFER_BIT is removed here:
+        {.queueFlags = VK_QUEUE_SPARSE_BINDING_BIT,
+         .queueCount = 2,
+         .timestampValidBits = 64,
+         .minImageTransferGranularity = {1, 1, 1}},
+        {.queueFlags = VK_QUEUE_COMPUTE_BIT | VK_QUEUE_TRANSFER_BIT,
+         .queueCount = 8,
+         .timestampValidBits = 64,
+         .minImageTransferGranularity = {1, 1, 1}}};
