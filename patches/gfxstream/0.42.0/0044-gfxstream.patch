+class ReadbackDiagnostics {
+   public:
+    using Clock = std::chrono::steady_clock;
+    using Now = Clock::time_point (*)();
+    explicit ReadbackDiagnostics(Now now = Clock::now)
+        : mNow(now), mLastLog(now() - std::chrono::minutes(1)) {}
