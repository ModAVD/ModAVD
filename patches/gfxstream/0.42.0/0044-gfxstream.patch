--- a/host/gl/context_helper.h
+++ b/host/gl/context_helper.h
@@ -14,6 +14,13 @@
 
 #pragma once
 
+#include <atomic>
+#include <cstddef>
+#include <functional>
+#include <mutex>
+#include <utility>
+#include <vector>
