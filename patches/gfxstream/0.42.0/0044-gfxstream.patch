+
+// Counts requested/read-back bytes, never driver allocations or leaked bytes.
+// HostFrame counts callback submissions, not reads by a shared-memory consumer.
+enum class ReadbackSource {
+    Guest,
+    GuestDma,
+    HostScreenshot,
+    HostQuery,
+    HostFrame,
+    GlPixels,
+    GlScaled,
