From 807569a999e4e0a760abeb704f2e5c77eeaee817 Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Sat, 26 Sep 2026 17:51:29 +0200
Subject: [PATCH 03/23] framebuffer: read back display frames without GL
 emulation (GuestAngle)

With -feature GuestAngle the host runs Vulkan-only and never creates a
ReadbackWorker, so screenrecord/share-vid dereferenced a null worker and
crashed or froze the emulator. Skip the worker when it is absent and fill
the screen-recording shared memory via ColorBuffer::readToBytes instead.

Patch: 0004-gfxstream-readback-without-gl-emulation.diff

Change-Id: Iae8f13f49628ad2e72554b54bce01829bc82cfea
---
 host/frame_buffer.cpp | 54 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/host/frame_buffer.cpp b/host/frame_buffer.cpp
index be726e60..33443e79 100644
--- a/host/frame_buffer.cpp
+++ b/host/frame_buffer.cpp
@@ -1581,8 +1581,51 @@ FrameBuffer::Impl::~Impl() {
     }
 }
 
+// MAS: see post(). Only 32-bit RGBA / RGBX / BGRA color buffers of the display's size.
+static void readbackColorBufferNoWorker(ColorBuffer* cb, unsigned char* img, uint32_t width,
+                                        uint32_t height, bool wantBgra) {
+    if (!cb || !img || cb->getWidth() != width || cb->getHeight() != height) {
+        return;
+    }
+    const GfxstreamFormat format = cb->getFormat();
+    const bool srcBgra = format == GfxstreamFormat::B8G8R8A8_UNORM;
+    if (!srcBgra && format != GfxstreamFormat::R8G8B8A8_UNORM &&
+        format != GfxstreamFormat::R8G8B8X8_UNORM) {
+        return;
+    }
+    const uint64_t size = 4ull * width * height;
+    cb->readToBytes(0, 0, (int)width, (int)height, format, img, size);
+    if (srcBgra != wantBgra) {
+        for (uint64_t i = 0; i < size; i += 4) {
+            const unsigned char t = img[i];
+            img[i] = img[i + 2];
+            img[i + 2] = t;
+        }
+    }
+}
+
 WorkerProcessingResult FrameBuffer::Impl::sendReadbackWorkerCmd(const Readback& readback) {
     ensureReadbackWorker();
+    if (!m_readbackWorker) {
+        // MAS: no GL emulation (GuestAngle => guestVulkanOnly), so there is no ReadbackWorker;
+        // m_readbackWorker->init() used to dereference null here as soon as anything set a
+        // post callback (`screenrecord webrtc start`, -share-vid): the emulator crashed, or hung
+        // inside the crash handler while another thread waited for the BQL. post() fills
+        // m_onPost[..].img synchronously through Vulkan instead; serve GetPixels from it.
+        if (readback.cmd == ReadbackCmd::Exit) {
+            return WorkerProcessingResult::Stop;
+        }
+        if (readback.cmd == ReadbackCmd::GetPixels && readback.pixelsOut) {
+            const auto it = m_onPost.find(readback.displayId);
+            if (it != m_onPost.end() && it->second.img) {
+                const uint64_t available =
+                        4ull * it->second.width * it->second.height;
+                memcpy(readback.pixelsOut, it->second.img,
+                       std::min<uint64_t>(readback.bytes, available));
+            }
+        }
+        return WorkerProcessingResult::Continue;
+    }
     switch (readback.cmd) {
     case ReadbackCmd::Init:
         m_readbackWorker->init();
@@ -2713,6 +2756,12 @@ AsyncResult FrameBuffer::Impl::postImpl(HandleType p_colorbuffer, Post::Completi
                 if (m_readbackWorker) {
                     m_readbackWorker->doNextReadbackSync(cb.get(), iter.second.img,
                                                          iter.second.readBgra);
+                } else {
+                    // MAS: Vulkan-only (GuestAngle): read the posted color buffer through
+                    // Vulkan, like rcReadColorBuffer does, so the screencap shared memory
+                    // (SHM_videmulator<port>) keeps working.
+                    readbackColorBufferNoWorker(cb.get(), iter.second.img, iter.second.width,
+                                                iter.second.height, iter.second.readBgra);
                 }
                 doPostCallback(iter.second.img, iter.first);
             }
@@ -2755,6 +2804,11 @@ void FrameBuffer::Impl::flushReadPipeline(int displayId) {
     }
 
     ensureReadbackWorker();
+    if (!m_readbackWorker) {
+        // MAS: Vulkan-only, post() already delivered the synchronous readback.
+        doPostCallback(iter->second.img, displayId);
+        return;
+    }
 
     const auto status = m_readbackWorker->flushPipeline(displayId);
     if (status == ReadbackWorker::FlushResult::OK_READY_FOR_READ) {
