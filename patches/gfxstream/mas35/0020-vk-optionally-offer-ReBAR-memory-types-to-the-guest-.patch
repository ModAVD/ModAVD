From f3461512de63d52f5d205a9f67824012d974c9c5 Mon Sep 17 00:00:00 2001
From: qiyinxi <qiyinxi@foxmail.com>
Date: Thu, 15 Oct 2026 20:22:09 +0200
Subject: [PATCH 20/23] vk: optionally offer ReBAR memory types to the guest as
 device-local only

ANDROID_EMU_VK_HIDE_REBAR=1 (off by default) clears HOST_VISIBLE,
HOST_COHERENT and HOST_CACHED from the guest view of every host memory
type that is both DEVICE_LOCAL and HOST_VISIBLE (NVIDIA's resizable BAR
VRAM type). Type indices, heaps and memoryTypeBits stay the same, so
images and device-local buffers keep getting the same host type; only
CPU mapping of VRAM goes away.

Endfield allocates 192 MB of such memory (guest type 4 -> host type 4,
flags 0x7) and copies its per-frame uploads into it through the address
space mapping. On the host that is write-combined VRAM behind PCIe, seen
through WHPX, and the copy loop dominated the render thread. With the
bit hidden the game uses the plain host-visible type, which
ANDROID_EMU_VK_WC_AS_CACHED backs with cached system memory.

Cost: buffers that used to live in VRAM are read by the GPU over PCIe.
Imports, blobs and dedicated allocations are untouched because their
memory type choice does not change.
---
 .../vk_emulated_physical_device_memory.cpp    | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/host/vulkan/vk_emulated_physical_device_memory.cpp b/host/vulkan/vk_emulated_physical_device_memory.cpp
index 0006d0a7..b8d0363d 100644
--- a/host/vulkan/vk_emulated_physical_device_memory.cpp
+++ b/host/vulkan/vk_emulated_physical_device_memory.cpp
@@ -18,6 +18,7 @@
 #include <limits>
 
 #include "gfxstream/common/logging.h"
+#include "gfxstream/system/System.h"
 
 namespace gfxstream {
 namespace host {
@@ -60,6 +61,35 @@ EmulatedPhysicalDeviceMemoryProperties::EmulatedPhysicalDeviceMemoryProperties(
               VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD);
     }
 
+    // MAS (Endfield, 10-15), off by default, ANDROID_EMU_VK_HIDE_REBAR=1 turns it on: offer the
+    // guest the host's device-local + host-visible types (NVIDIA ReBAR / BAR VRAM) as device-local
+    // only. A game that maps such memory writes its per-frame uploads straight into VRAM through
+    // the address space mapping, i.e. write-combined over PCIe and then through WHPX; Endfield's
+    // render thread spent most of its time in that copy loop. Without the host-visible bit the
+    // guest picks a plain host-visible type for those buffers, which ANDROID_EMU_VK_WC_AS_CACHED
+    // backs with cached system memory. The type index and heap stay the same, so images and
+    // buffers that need device-local memory still get the same host type (memoryTypeBits are
+    // unchanged); only CPU mapping of VRAM goes away. GPU reads of the moved buffers cross PCIe
+    // instead of hitting VRAM.
+    if (gfxstream::base::getEnvironmentVariable("ANDROID_EMU_VK_HIDE_REBAR") == "1") {
+        constexpr VkMemoryPropertyFlags kRebar =
+            VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT | VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
+        constexpr VkMemoryPropertyFlags kHostAccess = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                      VK_MEMORY_PROPERTY_HOST_COHERENT_BIT |
+                                                      VK_MEMORY_PROPERTY_HOST_CACHED_BIT;
+        for (uint32_t i = 0; i < mGuestMemoryProperties.memoryTypeCount; i++) {
+            const VkMemoryPropertyFlags hostFlags =
+                mHostMemoryProperties.memoryTypes[i].propertyFlags;
+            if ((hostFlags & kRebar) == kRebar) {
+                mGuestMemoryProperties.memoryTypes[i].propertyFlags &= ~kHostAccess;
+                GFXSTREAM_INFO(
+                    "MAS: memory type %u (host flags 0x%x, heap %u) offered to the guest as "
+                    "device-local only (ANDROID_EMU_VK_HIDE_REBAR)",
+                    i, hostFlags, mHostMemoryProperties.memoryTypes[i].heapIndex);
+            }
+        }
+    }
+
     // If enabled, hide non device memory types from the guest.
     // (useful to work around a bug where KVM can't map TTM memory).
     if (features.VulkanAllocateDeviceMemoryOnly.enabled()) {
