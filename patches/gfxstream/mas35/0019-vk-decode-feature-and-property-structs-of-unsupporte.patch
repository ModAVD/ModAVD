+// Returns the layout of a query-only struct, or nullptr if |structType| is not one.
+inline const QueryOnlyStructInfo* goldfish_vk_query_only_struct_info(uint32_t structType) {
+    for (const QueryOnlyStructInfo& info : kQueryOnlyStructs) {
+        if (static_cast<uint32_t>(info.sType) == structType) {
+            return &info;
+        }
+    }
+    return nullptr;
