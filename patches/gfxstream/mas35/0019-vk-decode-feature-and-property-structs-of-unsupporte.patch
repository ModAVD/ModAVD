+// Feature and property structs that guests may chain into vkGetPhysicalDeviceFeatures2,
+// vkGetPhysicalDeviceProperties2 or vkCreateDevice, but whose extensions gfxstream does not
+// support, so the generated marshaling code has no case for them. Older guest encoders were
+// generated against the whole registry and still send them; without a codec the host aborts.
+//
+// Each entry gives the C layout of the struct's wire fields in wire order. The wire format of
+// these plain-data structs is: sType, the pNext chain, then every field as raw bytes, except
+// size_t which is a big-endian 64-bit value.
+//
+// Generated from vk.xml by scripts/gen-query-only-structs.py; do not edit by hand.
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <vulkan/vulkan_core.h>
+
+namespace gfxstream {
+namespace host {
+namespace vk {
+
+enum class QueryOnlyFieldKind : uint32_t {
+    kRaw = 0,
+    kSizeT = 1,
+};
+
+struct QueryOnlyField {
+    uint32_t offset;
+    uint32_t size;
+    QueryOnlyFieldKind kind;
+};
+
+struct QueryOnlyStructInfo {
+    VkStructureType sType;
+    uint32_t structSize;
+    const QueryOnlyField* fields;
+    uint32_t fieldCount;
+};
+
+#define GFXSTREAM_QUERY_ONLY_FIELD(T, member, kind) \
+    {static_cast<uint32_t>(offsetof(T, member)),    \
+     static_cast<uint32_t>(sizeof(static_cast<T*>(nullptr)->member)), QueryOnlyFieldKind::kind}
