diff --git a/host/gl/glestranslator/egl/egl_context.cpp b/host/gl/glestranslator/egl/egl_context.cpp
index e80eb78b..f1a13c76 100644
--- a/host/gl/glestranslator/egl/egl_context.cpp
+++ b/host/gl/glestranslator/egl/egl_context.cpp
@@ -19,6 +19,7 @@
 #include "egl_os_api.h"
 #include "egl_pbuffer_surface.h"
 #include "thread_info.h"
+#include "gfxstream/common/logging.h"
 
 #include <common/gles_context.h>
 #include <memory>
@@ -129,9 +130,14 @@ EglContext::~EglContext()
                 m_config->nativeFormat(), &pbInfo);
         assert(pb);
         if (pb) {
-            const bool res = m_dpy->nativeType()->makeCurrent(pb, pb, m_native.get());
-            assert(res);
-            (void)res;
+            // This can fail for real, e.g. with ERROR_BUSY on Windows while
+            // the context is current on another thread. Do not assert: the
+            // GL objects are then not released through this context, but
+            // the native context itself is still destroyed.
+            if (!m_dpy->nativeType()->makeCurrent(pb, pb, m_native.get())) {
+                GFXSTREAM_ERROR("Failed to make EGL context %p current to destroy it",
+                                this);
+            }
             pbSurface->setNativePbuffer(pb);
         }
     }
diff --git a/host/gl/glestranslator/egl/egl_imp.cpp b/host/gl/glestranslator/egl/egl_imp.cpp
index 5d590558..7dffb9b4 100644
--- a/host/gl/glestranslator/egl/egl_imp.cpp
+++ b/host/gl/glestranslator/egl/egl_imp.cpp
@@ -1166,6 +1166,18 @@ EGLAPI EGLBoolean EGLAPIENTRY eglMakeCurrent(EGLDisplay display,
                         newReadPtr->native(),
                         newDrawPtr->native(),
                         newCtx->nativeType())) {
+                // The previous context cannot be assumed to be current any
+                // more: wglMakeCurrent() makes the current context not
+                // current when it fails. Release it explicitly and record
+                // that this thread has no current context, so that EGL agrees
+                // with the native state and a later eglMakeCurrent() of the
+                // previous context really binds it again.
+                if (prevCtx.get()) {
+                    dpy->nativeType()->makeCurrent(NULL, NULL, NULL);
+                    thread->updateInfo(ContextPtr(), dpy, NULL, ShareGroupPtr(),
+                                       dpy->getManager(prevCtx->version()));
+                    prevCtx->setSurfaces(SurfacePtr(), SurfacePtr());
+                }
                 RETURN_ERROR(EGL_FALSE,EGL_BAD_ACCESS);
             }
             //TODO: handle the following errors
